			<Item class="Script" referent="RBXCFBE06C74A444BECA4A43FB8E1A1FF54">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Main: the starting point for all server-side game code.
-- It checks the map, sets up each player and starts the game systems.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local log = require(ReplicatedStorage.Shared.Log)
local Score = require(script.Parent.Score)
local PlayerState = require(script.Parent.PlayerState)
local SafeZoneService = require(script.Parent.SafeZoneService)
local MonsterService = require(script.Parent.MonsterService)
local PowerService = require(script.Parent.PowerService)
local SkinService = require(script.Parent.SkinService)
local RoundService = require(script.Parent.RoundService)

-- Warns about any map folder that is missing from Workspace.
local function checkMap()
	for _, folderName in GameConfig.MapFolders do
		if not workspace:FindFirstChild(folderName) then
			warn("[TheLastLight] Missing folder in Workspace: " .. folderName)
		end
	end
end

local function onPlayerAdded(player: Player)
	Score.setup(player)
	SkinService.setup(player)
	PlayerState.setup(player) -- also spawns their character
end

checkMap()

Players.CharacterAutoLoads = false -- PlayerState decides when characters spawn
Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do -- players who joined before this script ran
	onPlayerAdded(player)
end

SafeZoneService.start()
PowerService.start()
SkinService.start()
MonsterService.start()
RoundService.start() -- also spawns the mushrooms at the start of each round
log("Server started")
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{21545FF3-65DA-41C7-B042-5B4282C6426E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Main</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00000c34</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXFB61F726D5A74FDE84993C76228B75C8">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Score: keeps each player's round points and round stats.
-- Points and status live in a "leaderstats" folder, which Roblox shows in the player
-- list (top right): "Points" and "Status" (In the woods / Caught). Only the server
-- changes them, so clients can't fake a score.
-- Round stats are attributes on the Player, read by the results screen:
--   RoundMushrooms   mushrooms collected this round
--   RoundBlackouts   blackouts survived this round
--   RoundBonus       survival bonus points earned this round
--   SurvivedDawn     true if they were still in the woods at dawn

local Score = {}

local STATS = { "RoundMushrooms", "RoundBlackouts", "RoundBonus" }
local STATUS_TEXT = { [true] = "Caught", [false] = "In the woods" }

local function getStat(player: Player, name: string): ValueBase?
	local leaderstats = player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild(name)
end

function Score.setup(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local points = Instance.new("IntValue")
	points.Name = "Points"
	points.Parent = leaderstats

	local status = Instance.new("StringValue")
	status.Name = "Status"
	status.Value = STATUS_TEXT[false]
	status.Parent = leaderstats

	leaderstats.Parent = player

	-- Keep the status in step with the "Caught" attribute that PlayerState sets.
	player:GetAttributeChangedSignal("Caught"):Connect(function()
		status.Value = STATUS_TEXT[player:GetAttribute("Caught") == true]
	end)
	Score.reset(player)
end

function Score.add(player: Player, amount: number)
	local points = getStat(player, "Points")
	if points then
		points.Value += amount
	end
end

-- Adds to one of the round stats (see the list at the top).
function Score.addStat(player: Player, name: string, amount: number)
	player:SetAttribute(name, (player:GetAttribute(name) or 0) + amount)
end

-- A survival bonus: points plus the RoundBonus stat.
function Score.addBonus(player: Player, amount: number)
	Score.add(player, amount)
	Score.addStat(player, "RoundBonus", amount)
end

function Score.reset(player: Player)
	local points = getStat(player, "Points")
	if points then
		points.Value = 0
	end
	for _, name in STATS do
		player:SetAttribute(name, 0)
	end
	player:SetAttribute("SurvivedDawn", false)
end

return Score
]]></ProtectedString>
					<string name="ScriptGuid">{DD0C11A1-A22C-48F5-92C5-DC3058A803FF}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Score</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00001c38</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB42414E0623E4E7BBD4784C41F8FD110">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MushroomService: spawns mushrooms at the markers in Workspace.MushroomSpawns
-- (their look comes from MushroomModels) and handles collecting them.
-- Every check happens here on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local MushroomConfig = require(ReplicatedStorage.Shared.MushroomConfig)
local log = require(ReplicatedStorage.Shared.Log)
local Score = require(script.Parent.Score)
local PowerService = require(script.Parent.PowerService)
local Remotes = require(script.Parent.Remotes)
local MushroomModels = require(script.Parent.MushroomModels)

local MushroomService = {}

local activeFolder: Folder -- holds this round's mushrooms

-- True during the phases listed in GameConfig.CollectPhases (RoundService sets the phase).
local function isCollectPhase(): boolean
	return GameConfig.CollectPhases[ReplicatedStorage:GetAttribute("Phase")] == true
end

-- True if the player is alive and standing close enough to the mushroom.
local function canReach(player: Player, position: Vector3): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and humanoid.Health > 0) then
		return false
	end
	return (root.Position - position).Magnitude <= GameConfig.CollectDistance
end

local function onCollect(player: Player, model: Model, kind: string)
	local config = MushroomConfig[kind]
	-- Already collected? (Destroyed models have no parent.) This stops double pickups.
	if not model.Parent then
		return
	end
	if not isCollectPhase() or not canReach(player, model.PrimaryPart.Position) then
		return
	end
	-- Only one unused power at a time; point-only mushrooms are always fine.
	if config.Power and not PowerService.canCarry(player) then
		local held = MushroomConfig[player:GetAttribute("Power")]
		Remotes.Notify:FireClient(player, "info", "Your hands are full", "Use your " .. held.DisplayName .. " first.")
		return
	end

	model:Destroy()
	Score.add(player, config.Points)
	Score.addStat(player, "RoundMushrooms", 1)
	if config.Power then
		PowerService.give(player, kind)
	end
	local style = config.Power and "rare" or "pickup"
	Remotes.Notify:FireClient(player, style, ("%s  +%d"):format(config.DisplayName, config.Points), config.Description)
	log(player.Name, "collected", config.DisplayName, "+" .. config.Points)
end

local function spawnAt(marker: BasePart)
	local kind = marker:GetAttribute("MushroomType")
	local config = MushroomConfig[kind]
	if not config then
		warn("[TheLastLight] Unknown MushroomType on " .. marker:GetFullName() .. ": " .. tostring(kind))
		return
	end

	local groundPosition = marker.Position - Vector3.new(0, marker.Size.Y / 2, 0)
	local model = MushroomModels.build(kind, config, groundPosition)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Collect"
	prompt.ObjectText = config.DisplayName
	prompt.MaxActivationDistance = GameConfig.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Enabled = isCollectPhase()
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		onCollect(player, model, kind)
	end)

	model.Parent = activeFolder
end

-- Removes any leftover mushrooms and spawns a fresh one at every marker.
function MushroomService.spawnAll()
	if activeFolder then
		activeFolder:Destroy() -- also disconnects the old prompts' events
	end
	activeFolder = Instance.new("Folder")
	activeFolder.Name = "Mushrooms"
	activeFolder.Parent = workspace

	local spawns = workspace:FindFirstChild("MushroomSpawns")
	if not spawns then
		return -- Main already warns about the missing folder
	end
	for _, marker in spawns:GetChildren() do
		spawnAt(marker)
	end
	log("Mushrooms spawned:", #activeFolder:GetChildren())
end

-- Show the "Collect" prompts only while collecting is allowed. This is just for
-- clarity on screen; onCollect still checks the phase, so it stays secure.
ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
	if not activeFolder then
		return
	end
	local enabled = isCollectPhase()
	for _, item in activeFolder:GetDescendants() do
		if item:IsA("ProximityPrompt") then
			item.Enabled = enabled
		end
	end
end)

return MushroomService
]]></ProtectedString>
					<string name="ScriptGuid">{FA6BEB20-F77C-4ABD-B480-4161C872CDB9}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MushroomService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00001c3a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE81AA0F448A84368B07876BA14A447FA">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- RoundService: owns the round timer. It is the ONLY script that changes the phase.
-- It publishes the round state as attributes on ReplicatedStorage, which every
-- client can read (including players who join mid-round):
--   Phase        current phase name, e.g. "Exploring"
--   Cycle        current night (1-4), or 0 during Lobby and Results
--   PhaseEndsAt  server time when the phase ends (compare with workspace:GetServerTimeNow())

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local log = require(ReplicatedStorage.Shared.Log)
local Score = require(script.Parent.Score)
local MushroomService = require(script.Parent.MushroomService)
local PlayerState = require(script.Parent.PlayerState)
local PowerService = require(script.Parent.PowerService)

local CHECK_INTERVAL = 0.25 -- how often a phase checks whether everyone was caught

local RoundService = {}

-- Announces a phase, then waits until it is over. With `canEndEarly`, it stops as soon as
-- every player has been caught and returns false.
local function runPhase(phase: string, cycle: number, canEndEarly: boolean?): boolean
	local duration = GameConfig.PhaseDurations[phase] * GameConfig.TimeScale
	ReplicatedStorage:SetAttribute("Cycle", cycle)
	ReplicatedStorage:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow() + duration)
	ReplicatedStorage:SetAttribute("Phase", phase) -- set last: scripts react to this one changing
	log(("Phase: %s (night %d, %.1fs)"):format(phase, cycle, duration))

	local endsAt = os.clock() + duration
	while os.clock() < endsAt do
		if canEndEarly and not PlayerState.anyoneLeft() then
			return false
		end
		task.wait(math.min(CHECK_INTERVAL, endsAt - os.clock()))
	end
	return true
end

-- Fresh mushrooms, scores back to 0, no powers, nobody caught, everyone back at the trailhead.
local function resetRound()
	MushroomService.spawnAll()
	for _, player in Players:GetPlayers() do
		Score.reset(player)
		PowerService.clear(player)
	end
	PlayerState.resetRound()
end

-- Gives every player who is still in the woods (not caught) a bonus.
-- `stat` (optional) also counts the event in that round stat.
local function rewardSurvivors(amount: number, stat: string?)
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("Caught") then
			Score.addBonus(player, amount)
			if stat then
				Score.addStat(player, stat, 1)
			end
		end
	end
end

-- Plays every night of the round, stopping early if everyone is caught.
-- Survivors earn a bonus after each blackout and a bigger one at dawn.
local function runNights()
	for cycle = 1, GameConfig.CyclesPerRound do
		for _, phase in GameConfig.CyclePhases do
			if not runPhase(phase, cycle, true) then
				log("Everyone was caught - ending the round early")
				return
			end
			if phase == "Blackout" then
				rewardSurvivors(GameConfig.Bonus.PerBlackout, "RoundBlackouts")
			end
		end
	end
	rewardSurvivors(GameConfig.Bonus.Dawn)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("SurvivedDawn", not player:GetAttribute("Caught"))
	end
	log("Dawn: survivors rewarded")
end

local function runRound()
	while #Players:GetPlayers() == 0 do
		Players.PlayerAdded:Wait()
	end

	resetRound()
	runPhase("Lobby", 0)
	runNights()
	runPhase("Results", 0)
end

-- Starts the endless round loop in the background.
function RoundService.start()
	task.spawn(function()
		while true do
			runRound()
		end
	end)
end

return RoundService
]]></ProtectedString>
					<string name="ScriptGuid">{D2D590F2-573A-470B-AAE1-E8EF9F699825}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RoundService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00002138</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA7381A2367104001A70A71C3041F67D3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- SafeZoneService: decides, on the server, who is standing inside a safe light.
-- A player is safe when their HumanoidRootPart (the centre of the character) is inside
-- one of the circles in Workspace.SafeZones, during a phase in GameConfig.SafeZonePhases.
--
-- The result is published as a "Safe" attribute on each Player so the HUD can show it.
-- Other server scripts (the monster, later) call SafeZoneService.isPlayerSafe(player).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local log = require(ReplicatedStorage.Shared.Log)

local CHECK_INTERVAL = 0.2 -- seconds between checks
-- How far below or above a circle the character's centre may be and still count
-- (the centre is about 3 studs above the ground, and players can jump).
local HEIGHT_BELOW = 4
local HEIGHT_ABOVE = 12

local SafeZoneService = {}

local zones = {} -- list of { center: Vector3, radius: number }

-- Reads the circles once. The circles are cylinders lying flat, so their diameter is Size.Y.
local function loadZones()
	local folder = workspace:FindFirstChild("SafeZones")
	if not folder then
		return -- Main already warns about the missing folder
	end
	for _, disc in folder:GetChildren() do
		if disc:IsA("BasePart") then
			table.insert(zones, { center = disc.Position, radius = disc.Size.Y / 2 })
		end
	end
end

-- True if a world position is inside any safe circle (ignores the phase).
-- `margin` (optional) makes the circles count as that many studs larger.
function SafeZoneService.isInsideZone(position: Vector3, margin: number?): boolean
	for _, zone in zones do
		local offset = position - zone.center
		local flatDistance = Vector2.new(offset.X, offset.Z).Magnitude
		if flatDistance <= zone.radius + (margin or 0) and offset.Y >= -HEIGHT_BELOW and offset.Y <= HEIGHT_ABOVE then
			return true
		end
	end
	return false
end

-- True if the player is protected right now: protection is active and they are inside a circle.
function SafeZoneService.isPlayerSafe(player: Player): boolean
	if not GameConfig.SafeZonePhases[ReplicatedStorage:GetAttribute("Phase")] then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and SafeZoneService.isInsideZone(root.Position)
end

local function updatePlayers()
	for _, player in Players:GetPlayers() do
		local safe = SafeZoneService.isPlayerSafe(player)
		if player:GetAttribute("Safe") ~= safe then
			player:SetAttribute("Safe", safe)
			log(player.Name, safe and "is safe" or "is not safe")
		end
	end
end

function SafeZoneService.start()
	loadZones()
	log("Safe zones loaded:", #zones)
	task.spawn(function()
		while true do
			updatePlayers()
			task.wait(CHECK_INTERVAL)
		end
	end)
end

return SafeZoneService
]]></ProtectedString>
					<string name="ScriptGuid">{56441453-7F56-481B-9DA2-F76ED2EFB281}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">SafeZoneService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00003b0d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXEE5B470977DC41EB9A3005C37668E847">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- PlayerState: tracks who is still in the round and who was caught.
-- "Caught" is an attribute on each Player: true means spectating until the next round.
-- Main turns off Players.CharacterAutoLoads, so characters spawn only when this
-- script says so. That is what keeps caught players out until the round ends.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local log = require(ReplicatedStorage.Shared.Log)

local RESPAWN_DELAY = 3 -- seconds before someone who died another way (e.g. fell off the map) respawns
local REMOVE_BODY_DELAY = 2 -- seconds before a caught player's body disappears

local PlayerState = {}

-- True if the player is in the round with a living character (the monster can chase them).
function PlayerState.isActive(player: Player): boolean
	if player:GetAttribute("Caught") then
		return false
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

-- True if at least one player has not been caught (used to end a round early).
function PlayerState.anyoneLeft(): boolean
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("Caught") then
			return true
		end
	end
	return false
end

function PlayerState.catch(player: Player)
	if player:GetAttribute("Caught") then
		return
	end
	player:SetAttribute("Caught", true) -- set first, so the Died handler below won't respawn them
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end
	task.delay(REMOVE_BODY_DELAY, function()
		if character and character.Parent then
			character:Destroy()
		end
	end)
	log(player.Name, "was caught")
end

-- Respawns players who die for any reason other than being caught.
local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.Died:Connect(function()
		if player:GetAttribute("Caught") then
			return
		end
		task.delay(RESPAWN_DELAY, function()
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
end

function PlayerState.setup(player: Player)
	player:SetAttribute("Caught", false)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player:LoadCharacter()
end

-- Start of a round: nobody is caught, and everyone respawns at the trailhead.
function PlayerState.resetRound()
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Caught", false)
		player:LoadCharacter()
	end
end

return PlayerState
]]></ProtectedString>
					<string name="ScriptGuid">{4FFC574A-116E-48E9-9EBA-2B5411C7F5ED}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PlayerState</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00004499</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXFA055E69DB414ECDB323C3DCBBFB1402">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MonsterService: the Hollow Stag (its look is built by MonsterModel).
-- States:
--   Hidden    - not in the world (Lobby, Gather, Release, Results)
--   Stalking  - during the Warning it stands still at a distant den, facing the players,
--               and growls. A warning glimpse only: it cannot catch anyone yet.
--   Hunting   - during Blackout it appears at a den and chases the nearest player
--               who is outside every safe light
--   Searching - if nobody can be chased, it walks to where it last saw someone, then waits
-- It never steps into a safe light, so it can't reach anyone standing inside one.
-- Everything here runs on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local log = require(ReplicatedStorage.Shared.Log)
local SafeZoneService = require(script.Parent.SafeZoneService)
local PlayerState = require(script.Parent.PlayerState)
local PowerService = require(script.Parent.PowerService)
local MonsterModel = require(script.Parent.MonsterModel)

local CONFIG = GameConfig.Monster
local RETARGET_INTERVAL = 0.5 -- seconds between "who is nearest?" checks
local PAUSE_AFTER_CATCH = 1.5 -- seconds it stands still after catching someone
local SAFE_ZONE_MARGIN = 2 -- keeps its body outside the light, not just its centre
local STEER_ANGLES = { 0, 45, -45, 90, -90 } -- directions tried when a safe light blocks the way
local STALK_EXTRA_DISTANCE = 20 -- while stalking it stays this much farther away than MinSpawnDistance
local GROWL_INTERVAL = NumberRange.new(5, 9) -- seconds between growls while hunting
local STRIDE_BOB = 0.18 -- how much it rises and falls with each step (studs)

local MonsterService = {}

local monster: Model
local huntConnection: RBXScriptConnection?
local target: Player?
local lastSeenPosition: Vector3?
local retargetTimer = 0
local pausedUntil = 0
local nextGrowlAt = 0
local walked = 0 -- distance walked, drives the stepping bob
local rng = Random.new()

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- Distance on the ground, ignoring height.
local function flatDistance(a: Vector3, b: Vector3): number
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

-- The monster may chase players who are in the round and outside every safe light.
local function isPrey(player: Player): boolean
	return PlayerState.isActive(player) and not SafeZoneService.isPlayerSafe(player)
end

local function nearestPrey(from: Vector3): Player?
	local best, bestDistance = nil, math.huge
	for _, player in Players:GetPlayers() do
		local root = getRoot(player)
		if root and isPrey(player) then
			local distance = flatDistance(root.Position, from)
			if distance < bestDistance then
				best, bestDistance = player, distance
			end
		end
	end
	return best
end

-- Picks a den that is at least `minDistance` from EVERY player, as close as possible
-- to a chaseable player. If everyone is safe, it lurks at the den closest to anyone,
-- ready for whoever steps out of the light. If no den is far enough, the farthest one.
local function chooseDen(minDistance: number): Vector3?
	local folder = workspace:FindFirstChild("MonsterSpawns")
	if not folder then
		return nil
	end
	local best, bestCloseness = nil, math.huge
	local farthest, farthestDistance = nil, -1
	for _, den in folder:GetChildren() do
		local nearestPlayer, nearestPreyDistance = math.huge, math.huge
		for _, player in Players:GetPlayers() do
			local root = getRoot(player)
			if root then
				local distance = flatDistance(root.Position, den.Position)
				nearestPlayer = math.min(nearestPlayer, distance)
				if isPrey(player) then
					nearestPreyDistance = math.min(nearestPreyDistance, distance)
				end
			end
		end
		-- If anyone can be chased, every den has a prey distance; otherwise use any player.
		local closeness = if nearestPreyDistance < math.huge then nearestPreyDistance else nearestPlayer
		if nearestPlayer >= minDistance and closeness < bestCloseness then
			best, bestCloseness = den, closeness
		end
		if nearestPlayer > farthestDistance then
			farthest, farthestDistance = den, nearestPlayer
		end
	end
	local chosen = best or farthest
	return chosen and chosen.Position
end

-- Moves toward `direction`. If that would enter a safe light, tries turning a little;
-- if every direction is blocked, it waits where it is.
local function moveToward(position: Vector3, direction: Vector3, distance: number)
	for _, angle in STEER_ANGLES do
		local turned = CFrame.Angles(0, math.rad(angle), 0):VectorToWorldSpace(direction)
		local nextPosition = position + turned * distance
		if not SafeZoneService.isInsideZone(nextPosition, SAFE_ZONE_MARGIN) then
			walked += distance
			local bob = math.abs(math.sin(walked * 0.9)) * STRIDE_BOB
			local standing = Vector3.new(nextPosition.X, MonsterModel.ROOT_HEIGHT + bob, nextPosition.Z)
			monster:PivotTo(CFrame.lookAt(standing, standing + turned))
			return
		end
	end
end

-- A Guardian Cap blocked the catch: the monster is thrown back (never into a light)
-- and stands still for a moment, giving the player time to run.
local function knockBack(position: Vector3, playerPosition: Vector3)
	local away = Vector3.new(position.X - playerPosition.X, 0, position.Z - playerPosition.Z)
	if away.Magnitude > 0.1 then
		local landing = position + away.Unit * GameConfig.Powers.ShieldKnockback
		if not SafeZoneService.isInsideZone(landing, SAFE_ZONE_MARGIN) then
			monster:PivotTo(CFrame.lookAt(landing, Vector3.new(playerPosition.X, landing.Y, playerPosition.Z)))
		end
	end
	pausedUntil = os.clock() + GameConfig.Powers.ShieldStunSeconds
end

local function growl()
	local sound = monster:FindFirstChild("Growl", true)
	if sound then
		sound:Play()
	end
	nextGrowlAt = os.clock() + rng:NextNumber(GROWL_INTERVAL.Min, GROWL_INTERVAL.Max)
end

-- Puts the monster at a den, turned toward the nearest player.
local function appearAt(den: Vector3)
	local standing = Vector3.new(den.X, MonsterModel.ROOT_HEIGHT, den.Z)
	local facing = standing - Vector3.new(0, 0, 1)
	local nearest, nearestDistance = nil, math.huge
	for _, player in Players:GetPlayers() do
		local root = getRoot(player)
		if root and flatDistance(root.Position, standing) < nearestDistance then
			nearest, nearestDistance = root, flatDistance(root.Position, standing)
		end
	end
	if nearest then
		facing = Vector3.new(nearest.Position.X, standing.Y, nearest.Position.Z)
	end
	monster:PivotTo(CFrame.lookAt(standing, facing))
	monster.Parent = workspace
end

-- Runs every frame during Blackout.
local function step(dt: number)
	if os.clock() < pausedUntil then
		return
	end

	if os.clock() >= nextGrowlAt then
		growl()
	end

	retargetTimer -= dt
	if retargetTimer <= 0 or (target and not isPrey(target)) then
		retargetTimer = RETARGET_INTERVAL
		target = nearestPrey(monster:GetPivot().Position)
	end

	local root = target and getRoot(target)
	if root then
		lastSeenPosition = root.Position
	end
	if not lastSeenPosition then
		return -- nobody to chase or search for: wait
	end

	local position = monster:GetPivot().Position
	local distance = flatDistance(lastSeenPosition, position)
	if root and distance <= CONFIG.CatchDistance then
		if PowerService.absorbCatch(target) then
			knockBack(position, root.Position)
		else
			PlayerState.catch(target)
			PowerService.clear(target)
			pausedUntil = os.clock() + PAUSE_AFTER_CATCH
		end
		target, lastSeenPosition = nil, nil
		return
	end
	if distance < 1 then
		lastSeenPosition = nil -- reached the last known spot and found nobody
		return
	end

	local cycle = ReplicatedStorage:GetAttribute("Cycle") or 1
	local speed = CONFIG.SpeedByNight[cycle] or CONFIG.SpeedByNight[#CONFIG.SpeedByNight]
	local flatOffset = Vector3.new(lastSeenPosition.X - position.X, 0, lastSeenPosition.Z - position.Z)
	moveToward(position, flatOffset.Unit, math.min(speed * dt, distance))
end

local function stopHunt()
	if huntConnection then
		huntConnection:Disconnect()
		huntConnection = nil
	end
	target, lastSeenPosition = nil, nil
end

local function hide()
	stopHunt()
	if monster.Parent then
		monster.Parent = nil
		log("Monster retreated")
	end
end

-- Warning: a distant glimpse and a growl, but no hunting yet.
local function startStalking()
	local den = chooseDen(CONFIG.MinSpawnDistance + STALK_EXTRA_DISTANCE)
	if den then
		appearAt(den)
		growl()
		log("Monster is stalking from", den)
	end
end

local function startHunt()
	local den = chooseDen(CONFIG.MinSpawnDistance)
	if not den then
		warn("[TheLastLight] No monster dens in Workspace.MonsterSpawns")
		return
	end
	stopHunt()
	target, lastSeenPosition, retargetTimer, pausedUntil = nil, nil, 0, 0
	appearAt(den)
	growl()
	huntConnection = RunService.Heartbeat:Connect(step)
	log("Monster is hunting from", den)
end

function MonsterService.start()
	monster = MonsterModel.build()
	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = ReplicatedStorage:GetAttribute("Phase")
		if phase == "Blackout" then
			startHunt()
		elseif phase == "Warning" then
			startStalking()
		else
			hide()
		end
	end)
end

return MonsterService
]]></ProtectedString>
					<string name="ScriptGuid">{81F64831-2527-4B99-A82C-E76D66888A5B}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MonsterService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000449b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8B63B68E19E0441FA653C84BCCA3FFD2">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Remotes: creates the RemoteEvents that server and clients use to talk, in
-- ReplicatedStorage.Remotes. Clients find them with WaitForChild.
--   UseAbility  client -> server: "I'd like to use my power." The server checks everything.
--   SelectSkin  client -> server: (skinName) "I'd like this look." Checked against SkinConfig.
--   Notify      server -> client: (style, title, detail) a short message to show on screen.
--               Styles: "pickup", "rare", "power", "shield", "info".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"
folder.Parent = ReplicatedStorage

local function makeEvent(name: string): RemoteEvent
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = folder
	return event
end

return {
	UseAbility = makeEvent("UseAbility"),
	SelectSkin = makeEvent("SelectSkin"),
	Notify = makeEvent("Notify"),
}
]]></ProtectedString>
					<string name="ScriptGuid">{751C3E12-87AE-43F9-8A37-3E311AB567D4}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Remotes</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000584a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6E846E7667E64948991ABB588BD88392">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- PowerService: the power mushrooms.
--   Ember Morel  ("Speed")  - the player presses the ability key for a short speed boost.
--   Guardian Cap ("Shield") - blocks the next catch automatically, then is used up.
-- The power a player carries is the "Power" attribute on their Player (a MushroomConfig
-- key, or nil). Clients can only ASK to use it through the UseAbility remote; the server
-- checks that they really have it, are still playing, and that it's the right phase.
-- While boosted, "BoostEndsAt" holds the server time the boost ends (for client effects).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local MushroomConfig = require(ReplicatedStorage.Shared.MushroomConfig)
local log = require(ReplicatedStorage.Shared.Log)
local Remotes = require(script.Parent.Remotes)
local PlayerState = require(script.Parent.PlayerState)

local CONFIG = GameConfig.Powers

local PowerService = {}

-- Returns the power type ("Speed"/"Shield") of what the player carries, or nil.
local function heldPower(player: Player): string?
	local config = MushroomConfig[player:GetAttribute("Power")]
	return config and config.Power
end

function PowerService.canCarry(player: Player): boolean
	return player:GetAttribute("Power") == nil
end

function PowerService.give(player: Player, kind: string)
	player:SetAttribute("Power", kind)
end

-- Removes any carried power and active boost (start of a round, or when caught).
function PowerService.clear(player: Player)
	player:SetAttribute("Power", nil)
	player:SetAttribute("BoostEndsAt", nil)
end

local function useSpeed(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local endsAt = workspace:GetServerTimeNow() + CONFIG.SpeedBoostSeconds
	humanoid.WalkSpeed = CONFIG.SpeedBoostWalkSpeed
	player:SetAttribute("BoostEndsAt", endsAt)
	task.delay(CONFIG.SpeedBoostSeconds, function()
		humanoid.WalkSpeed = StarterPlayer.CharacterWalkSpeed
		if player:GetAttribute("BoostEndsAt") == endsAt then
			player:SetAttribute("BoostEndsAt", nil)
		end
	end)
end

local function onUseAbility(player: Player)
	local phase = ReplicatedStorage:GetAttribute("Phase")
	if heldPower(player) ~= "Speed" or not CONFIG.UsePhases[phase] or not PlayerState.isActive(player) then
		return -- not allowed right now: ignore the request
	end
	player:SetAttribute("Power", nil)
	useSpeed(player)
	Remotes.Notify:FireClient(player, "power", "Ember Morel!", "Run!")
	log(player.Name, "used a speed boost")
end

-- Called by the monster when it reaches a player. Returns true if a Guardian Cap
-- blocked the catch (and uses it up).
function PowerService.absorbCatch(player: Player): boolean
	if heldPower(player) ~= "Shield" then
		return false
	end
	player:SetAttribute("Power", nil)
	Remotes.Notify:FireClient(player, "shield", "Your Guardian Cap shattered!", "Get to the light!")
	log(player.Name, "was saved by a Guardian Cap")
	return true
end

function PowerService.start()
	Remotes.UseAbility.OnServerEvent:Connect(onUseAbility)
end

return PowerService
]]></ProtectedString>
					<string name="ScriptGuid">{A60F429D-C911-463F-8C69-61486491527C}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PowerService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000584c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5044283D9A1C40768EB1C583966B9C13">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MushroomModels: builds the look of each mushroom type out of simple parts.
--   Mooncap      a small cluster of cream caps with softly glowing blue gills
--   EmberMorel   a tall, ridged orange-red cap with glowing ember flecks and sparks
--   GuardianCap  a wide violet dome with a bright glowing ring and pale spots
-- Every model's PrimaryPart is its main stem: the collect prompt sits there and the
-- server measures pickup distance from it. Colours come from MushroomConfig.

local MushroomModels = {}

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds" -- built into Roblox

-- A decorative part: anchored, walk-through, no shadow.
local function piece(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, parent: Instance, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape or Enum.PartType.Block
	part.Size = size
	part.Position = position
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = parent
	return part
end

-- A squashed dome made with a sphere mesh (lets the cap be wider than it is tall).
local function dome(name: string, size: Vector3, position: Vector3, color: Color3, parent: Instance): Part
	local cap = piece(name, size, position, color, Enum.Material.SmoothPlastic, parent)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = cap
	return cap
end

-- A thin flat disc (cylinder lying down), used for glowing gills and rings.
local function flatDisc(name: string, diameter: number, position: Vector3, color: Color3, parent: Instance): Part
	local disc = piece(name, Vector3.new(0.1, diameter, diameter), position, color, Enum.Material.Neon, parent, Enum.PartType.Cylinder)
	disc.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	return disc
end

local function addGlow(part: BasePart, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Parent = part
end

local function addParticles(part: BasePart, color: Color3, rate: number, upward: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE_TEXTURE
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(1.5, 2.5)
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(0.3, 0.8)
	emitter.Acceleration = Vector3.new(0, upward, 0)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Parent = part
end

-- One stem + cap + glowing gills; `scale` makes the smaller ones in a cluster.
local function mooncapStalk(ground: Vector3, scale: number, config, parent: Instance): Part
	local stemHeight = 1.4 * scale
	local stem = piece("Stem", Vector3.new(0.6, stemHeight, 0.6) * scale, ground + Vector3.new(0, stemHeight / 2, 0), config.StemColor, Enum.Material.SmoothPlastic, parent)
	dome("Cap", Vector3.new(2.4, 1.1, 2.4) * scale, ground + Vector3.new(0, stemHeight + 0.25 * scale, 0), config.CapColor, parent)
	flatDisc("Gills", 2 * scale, ground + Vector3.new(0, stemHeight - 0.05, 0), config.GlowColor, parent)
	return stem
end

local function buildMooncap(model: Model, ground: Vector3, config)
	model.PrimaryPart = mooncapStalk(ground, 1, config, model)
	mooncapStalk(ground + Vector3.new(0.95, 0, 0.6), 0.55, config, model)
	mooncapStalk(ground + Vector3.new(-0.7, 0, 0.85), 0.4, config, model)
	addGlow(model.PrimaryPart, config.GlowColor, 9, 1.2)
	addParticles(model.PrimaryPart, config.GlowColor, 1.5, 0.3)
end

local function buildEmberMorel(model: Model, ground: Vector3, config)
	local stem = piece("Stem", Vector3.new(0.7, 1.2, 0.7), ground + Vector3.new(0, 0.6, 0), config.StemColor, Enum.Material.SmoothPlastic, model)
	model.PrimaryPart = stem
	-- Stacked balls with a bumpy texture read as a tall, ridged morel cap.
	local layers = { { 1.7, 1.7 }, { 1.35, 2.6 }, { 0.95, 3.35 } } -- { diameter, height }
	for i, layer in layers do
		piece("Cap" .. i, Vector3.one * layer[1], ground + Vector3.new(0, layer[2], 0), config.CapColor, Enum.Material.Cobblestone, model, Enum.PartType.Ball)
	end
	local flecks = { Vector3.new(0.75, 1.9, 0.3), Vector3.new(-0.6, 2.3, -0.45), Vector3.new(0.2, 2.9, -0.6), Vector3.new(-0.35, 3.4, 0.35), Vector3.new(0.55, 2.7, 0.55) }
	for i, offset in flecks do
		piece("Ember" .. i, Vector3.one * 0.28, ground + offset, config.GlowColor, Enum.Material.Neon, model, Enum.PartType.Ball)
	end
	addGlow(stem, config.GlowColor, 9, 1.4)
	addParticles(stem, config.GlowColor, 4, 2)
end

local function buildGuardianCap(model: Model, ground: Vector3, config)
	local stem = piece("Stem", Vector3.new(0.9, 1.7, 0.9), ground + Vector3.new(0, 0.85, 0), config.StemColor, Enum.Material.SmoothPlastic, model)
	model.PrimaryPart = stem
	local capCenter = ground + Vector3.new(0, 1.95, 0)
	dome("Cap", Vector3.new(3.4, 1.5, 3.4), capCenter, config.CapColor, model)
	flatDisc("Ring", 3.65, capCenter - Vector3.new(0, 0.1, 0), config.GlowColor, model) -- the bright ring around the rim
	local spots = { Vector3.new(0, 0.7, 0), Vector3.new(0.85, 0.5, 0.3), Vector3.new(-0.7, 0.5, 0.55), Vector3.new(0.1, 0.5, -0.9), Vector3.new(-0.6, 0.45, -0.55) }
	for i, offset in spots do
		piece("Spot" .. i, Vector3.one * 0.32, capCenter + offset, Color3.fromRGB(245, 235, 255), Enum.Material.Neon, model, Enum.PartType.Ball)
	end
	addGlow(stem, config.GlowColor, 11, 1.6)
	addParticles(stem, config.GlowColor, 3, 0.6)
end

local BUILDERS = {
	Mooncap = buildMooncap,
	EmberMorel = buildEmberMorel,
	GuardianCap = buildGuardianCap,
}

-- Builds a mushroom of type `kind` standing on `ground`. Returns the Model (not parented).
function MushroomModels.build(kind: string, config, ground: Vector3): Model
	local model = Instance.new("Model")
	model.Name = config.DisplayName
	model:SetAttribute("MushroomType", kind)
	local builder = BUILDERS[kind] or buildMooncap
	builder(model, ground, config)
	return model
end

return MushroomModels
]]></ProtectedString>
					<string name="ScriptGuid">{1CF9C76E-BDD4-4A98-A5B0-CD9B393E45D6}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MushroomModels</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00009aa2</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX84C1992DB95C4E2CA0A9532726ABA57D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MonsterModel: builds the Hollow Stag out of simple parts. A tall, thin, deer-like
-- shape with a pale skull for a head, dim glowing eyes and uneven antlers, so it reads
-- clearly as a silhouette in the fog. Not graphic: no gore, just wrong proportions.
--
-- The model faces -Z (forward). Its PrimaryPart "Root" is an invisible block at ground
-- level; MonsterService moves the model by moving that pivot.

local MonsterModel = {}

local BODY_COLOR = Color3.fromRGB(14, 14, 18)
local BONE_COLOR = Color3.fromRGB(196, 190, 174)
local EYE_COLOR = Color3.fromRGB(200, 255, 230)
local GROWL_SOUND_ID = "rbxassetid://9114628818" -- deep growl (Pro Sound Effects), pitched down

MonsterModel.ROOT_HEIGHT = 0.5 -- the Root part's centre above the ground

local function addPart(model: Model, name: string, props): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = BODY_COLOR
	if props.Shape then
		part.Shape = props.Shape -- before Size, so Size isn't adjusted afterwards
	end
	for key, value in props do
		if key ~= "Shape" then
			part[key] = value
		end
	end
	part.Parent = model
	return part
end

-- A cylinder between two points (legs, neck, antlers). Points are in model space.
local function addLimb(model: Model, name: string, from: Vector3, to: Vector3, thickness: number, color: Color3?): Part
	local middle = (from + to) / 2
	return addPart(model, name, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new((to - from).Magnitude, thickness, thickness),
		CFrame = CFrame.lookAt(middle, to) * CFrame.Angles(0, math.pi / 2, 0),
		Color = color or BODY_COLOR,
	})
end

-- A stretched sphere (the body), using a mesh so it can be longer than it is wide.
local function addOval(model: Model, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local part = addPart(model, name, { Size = size, CFrame = CFrame.new(position), Color = color })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Legs bend in the middle; back legs bend backwards like a deer's.
local function addLeg(model: Model, hip: Vector3, kneeShift: number)
	local knee = Vector3.new(hip.X, 3.8, hip.Z + kneeShift)
	local hoof = Vector3.new(hip.X, 0, hip.Z - kneeShift * 0.5)
	addLimb(model, "UpperLeg", hip, knee, 0.55)
	addLimb(model, "LowerLeg", knee, hoof, 0.4)
end

-- Each antler is a list of { from, to } branches; left and right differ on purpose.
local ANTLERS = {
	{ Vector3.new(-0.4, 13.3, -3.9), Vector3.new(-2.2, 16.5, -3.3) },
	{ Vector3.new(-2.2, 16.5, -3.3), Vector3.new(-3.7, 18.6, -2.6) },
	{ Vector3.new(-1.5, 15.3, -3.5), Vector3.new(-2.7, 16.3, -5.1) },
	{ Vector3.new(-3, 17.6, -2.9), Vector3.new(-2.7, 19.7, -3.7) },
	{ Vector3.new(0.4, 13.3, -3.9), Vector3.new(1.9, 15.8, -3.4) },
	{ Vector3.new(1.9, 15.8, -3.4), Vector3.new(3.3, 17.3, -2.7) },
	{ Vector3.new(1.3, 14.9, -3.6), Vector3.new(2.4, 15.5, -5.2) },
}

function MonsterModel.build(): Model
	local model = Instance.new("Model")
	model.Name = "Monster"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent -- visible from far away

	local root = addPart(model, "Root", { Size = Vector3.new(3, 1, 3), CFrame = CFrame.new(0, MonsterModel.ROOT_HEIGHT, 0), Transparency = 1 })
	model.PrimaryPart = root

	addOval(model, "Body", Vector3.new(2.4, 2.8, 6.2), Vector3.new(0, 8, 0.4), BODY_COLOR)
	for _, x in { -0.75, 0.75 } do
		addLeg(model, Vector3.new(x, 7.6, -2), -0.4) -- front
		addLeg(model, Vector3.new(x, 7.6, 2.8), 0.9) -- back
	end
	addLimb(model, "Neck", Vector3.new(0, 8.6, -2.2), Vector3.new(0, 12.2, -3.5), 1.1)

	-- The skull, tilted slightly down, with a narrower snout.
	local skullCFrame = CFrame.new(0, 12.7, -4.2) * CFrame.Angles(math.rad(-15), 0, 0)
	addPart(model, "Skull", { Size = Vector3.new(1.4, 1.4, 2), CFrame = skullCFrame, Color = BONE_COLOR })
	addPart(model, "Snout", { Size = Vector3.new(0.9, 0.8, 1.4), CFrame = skullCFrame * CFrame.new(0, -0.25, -1.5), Color = BONE_COLOR })
	for _, x in { -0.58, 0.58 } do
		addPart(model, "Eye", {
			Shape = Enum.PartType.Ball, Size = Vector3.one * 0.35, CFrame = skullCFrame * CFrame.new(x, 0.2, -0.55),
			Material = Enum.Material.Neon, Color = EYE_COLOR,
		})
	end
	for i, branch in ANTLERS do
		addLimb(model, "Antler" .. i, branch[1], branch[2], i % 4 == 1 and 0.32 or 0.22, BONE_COLOR)
	end

	-- A faint glow from the eyes so its shape shows in the dark, without lighting up the area.
	local glow = Instance.new("PointLight")
	glow.Color = EYE_COLOR
	glow.Range = 12
	glow.Brightness = 0.9
	glow.Parent = model:FindFirstChild("Skull")

	local growl = Instance.new("Sound")
	growl.Name = "Growl"
	growl.SoundId = GROWL_SOUND_ID
	growl.PlaybackSpeed = 0.7
	growl.Volume = 1
	growl.RollOffMinDistance = 10
	growl.RollOffMaxDistance = 110
	growl.Parent = model:FindFirstChild("Skull")
	return model
end

return MonsterModel
]]></ProtectedString>
					<string name="ScriptGuid">{3C002842-7F3D-4978-963B-5CFD10F5D61C}</string>
