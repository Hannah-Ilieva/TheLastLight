		CapColor = Color3.fromRGB(235, 225, 200), -- cream
		StemColor = Color3.fromRGB(215, 210, 195),
		GlowColor = Color3.fromRGB(120, 190, 255), -- soft blue
	},
}
]]></ProtectedString>
