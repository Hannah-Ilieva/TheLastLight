					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MapConfig: every number and colour the map generator (BuildMap) uses, in one place.
-- Coordinates: the camp is at (0, 0, 0), north is -Z, and the ground's top is at Y = 0.

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local MapConfig = {}

MapConfig.Trail = {
	HalfWidth = 6, -- trails are 12 studs wide
	HalfLength = 95,
}

MapConfig.Bounds = {
	Playable = 120, -- trees, rocks and mushrooms stay inside +/- this
	Wall = 126, -- invisible walls stop players here
	Backdrop = 148, -- trees beyond the walls, so the forest seems endless
}

MapConfig.Color = {
	Trail = rgb(92, 74, 56),
	SafeLight = rgb(255, 196, 110),
	Wood = rgb(96, 70, 50),
	DarkWood = rgb(58, 42, 32),
	DeadWood = rgb(88, 84, 78),
	Stone = rgb(70, 76, 74),
	Metal = rgb(40, 38, 36),
	Bone = rgb(215, 208, 190),
	PineGreens = { rgb(30, 56, 46), rgb(26, 50, 44), rgb(36, 62, 50), rgb(32, 54, 52) },
}

-- Terrain materials and the colours they are tinted.
MapConfig.TerrainColors = {
	[Enum.Material.Grass] = rgb(44, 70, 54),
	[Enum.Material.LeafyGrass] = rgb(52, 80, 52),
	[Enum.Material.Ground] = rgb(84, 68, 52),
	[Enum.Material.Mud] = rgb(52, 58, 56),
	[Enum.Material.Rock] = rgb(84, 90, 92),
	[Enum.Material.Slate] = rgb(74, 80, 86),
}

MapConfig.SafeZones = {
	{ Name = "SafeZone_Camp", X = 0, Z = 0, Diameter = 30, Stones = 12 },
	{ Name = "SafeZone_North", X = 0, Z = -60, Diameter = 22, Stones = 9 },
	{ Name = "SafeZone_West", X = -60, Z = 0, Diameter = 22, Stones = 9 },
	{ Name = "SafeZone_East", X = 60, Z = 0, Diameter = 22, Stones = 9 },
	{ Name = "SafeZone_South", X = 0, Z = 60, Diameter = 22, Stones = 9 },
}
MapConfig.SafeLight = {
	FloorGlowTransparency = 0.65, -- the glowing circle on the ground when shown
	LightRange = 30,
	LightBrightness = 2.2,
	BeaconHeight = 8,
}

-- Mushroom patch areas at the end of each spoke. Material is painted onto the terrain.
MapConfig.Areas = {
	{ Name = "NorthRidge", X = 0, Z = -95, Material = Enum.Material.Slate },
	{ Name = "WestGrove", X = -95, Z = 0, Material = Enum.Material.LeafyGrass },
	{ Name = "EastMarsh", X = 95, Z = 0, Material = Enum.Material.Mud },
}
MapConfig.AreaDiameter = 26

-- Invisible markers where the server spawns mushrooms each round (Workspace.MushroomSpawns).
-- Type must match a key in src/shared/MushroomConfig.luau.
-- Mooncaps sit beside the trails; Ember Morels at the grove and cabin edges;
-- Guardian Caps in the farthest patches (more risk for a better reward).
MapConfig.MushroomSpawns = {
	{ Name = "WestGrove_1", X = -86, Z = 9, Type = "Mooncap" },
	{ Name = "WestGrove_2", X = -100, Z = -8, Type = "Mooncap" },
	{ Name = "SouthTrail_1", X = 9, Z = 38, Type = "Mooncap" },
	{ Name = "NorthTrail_1", X = -9, Z = -38, Type = "Mooncap" },
	{ Name = "NorthTrail_2", X = 9, Z = -78, Type = "Mooncap" },
	{ Name = "EastTrail_1", X = 38, Z = 9, Type = "Mooncap" },
	{ Name = "EastTrail_2", X = 78, Z = -9, Type = "Mooncap" },
	{ Name = "WestTrail_1", X = -38, Z = -9, Type = "Mooncap" },
	{ Name = "CabinEdge", X = -31, Z = -27, Type = "EmberMorel" },
	{ Name = "WestGrove_Ember1", X = -106, Z = 12, Type = "EmberMorel" },
	{ Name = "WestGrove_Ember2", X = -84, Z = -23, Type = "EmberMorel" },
	{ Name = "NorthRidge_Guardian", X = 10, Z = -104, Type = "GuardianCap" },
	{ Name = "EastMarsh_Guardian", X = 106, Z = -10, Type = "GuardianCap" },
}

-- Invisible dens where the monster can appear (Workspace.MonsterSpawns).
-- They sit in the forest between the trails, away from the safe lights.
MapConfig.MonsterDens = {
	{ Name = "Den_NW", X = -40, Z = -40 }, { Name = "Den_NE", X = 40, Z = -40 },
	{ Name = "Den_SW", X = -40, Z = 40 }, { Name = "Den_SE", X = 40, Z = 40 },
	{ Name = "Den_FarWest", X = -105, Z = -45 }, { Name = "Den_FarEast", X = 105, Z = 45 },
	{ Name = "Den_FarNorth", X = 45, Z = -110 }, { Name = "Den_FarSouth", X = -45, Z = 110 },
}

-- Path lamps (Workspace.PathLights) stand beside each trail spoke and go dark during Blackout.
-- Distances are measured from the camp along the spoke; lamps alternate sides of the trail.
MapConfig.Lamps = {
	Distances = { 28, 44, 80 }, -- avoids the safe zones at 60 and the camp's edge at 15
	SideOffset = 8.5, -- studs from the trail's centre line (just off the trail)
	Spokes = {
		{ Name = "N", Direction = Vector2.new(0, -1) },
		{ Name = "W", Direction = Vector2.new(-1, 0) },
		{ Name = "E", Direction = Vector2.new(1, 0) },
		{ Name = "S", Direction = Vector2.new(0, 1) },
	},
	LanternColor = rgb(255, 170, 90),
}

-- The forest. Trees are scattered on a jittered grid; a fixed seed gives the same forest every run.
MapConfig.Forest = {
	Seed = 7,
	CellSize = 10, -- one tree candidate per cell
	Chance = 0.55, -- chance a cell gets a tree (if the spot is clear)
	DeadTreeChance = 0.1,
	TrailGap = 3, -- studs between a trunk and a trail edge
	Spacing = 7, -- minimum studs between two trunks
	ScaleMin = 0.8,
	ScaleMax = 1.45,
	RockCount = 45,
}

-- Places where trees and rocks must not appear: { X, Z, Radius }. Safe zones, areas,
-- mushroom spots and lamps are added automatically by the generator.
MapConfig.Keepout = {
	{ X = -20, Z = -18, Radius = 13 }, -- cabin
	{ X = 14, Z = -15, Radius = 5 }, -- crates
	{ X = -16, Z = -82, Radius = 11 }, -- fallen log
	{ X = 22, Z = -90, Radius = 8 }, -- split pine
	{ X = -95, Z = -16, Radius = 9 }, -- stump and roots
	{ X = 97, Z = 16, Radius = 8 }, -- dead tree
	{ X = 0, Z = 92, Radius = 14 }, -- trailhead gate and spawn
	{ X = 14, Z = 86, Radius = 5 }, -- trailhead sign
	{ X = 19, Z = 19, Radius = 4 }, -- camp map board
}

return MapConfig
]]></ProtectedString>
					<string name="ScriptGuid">{73BED720-1A18-417D-8DEE-483062E44F94}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MapConfig</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00006007</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX03A3E9CA2FCD4AB6AF171AF7BF4D799B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MapKit: small building helpers shared by the map generator modules.
-- Everything created here gets the "Generated" attribute, so BuildMap can delete
-- and rebuild it safely without touching objects you added by hand.

local CollectionService = game:GetService("CollectionService")

local MapKit = {}

MapKit.GENERATED = "Generated"

-- Creates an anchored part from a table of Roblox property names.
-- Place it with either `CFrame`, or `Position` (+ optional `Orientation` in degrees,
-- like the Properties window). `Tag` adds a CollectionService tag.
function MapKit.part(spec, parent: Instance, className: string?): BasePart
	local part = Instance.new(className or "Part")
	part.Anchored = true
	if part:IsA("Part") then
		part.Shape = spec.Shape or Enum.PartType.Block -- set before Size so Size isn't adjusted afterwards
	end
	for key, value in spec do
		if key ~= "Position" and key ~= "Orientation" and key ~= "Shape" and key ~= "CFrame" and key ~= "Tag" then
			part[key] = value
		end
	end
	if spec.CFrame then
		part.CFrame = spec.CFrame
	else
		local o = spec.Orientation or Vector3.zero
		part.CFrame = CFrame.new(spec.Position) * CFrame.fromOrientation(math.rad(o.X), math.rad(o.Y), math.rad(o.Z))
	end
	if spec.Tag then
		CollectionService:AddTag(part, spec.Tag)
	end
	part:SetAttribute(MapKit.GENERATED, true)
	part.Parent = parent
	return part
end

-- Copies `look` and adds the extra fields, so one "look" table can be reused.
function MapKit.with(look, extra)
	local spec = table.clone(look)
	for key, value in extra do
		spec[key] = value
	end
	return spec
end

-- A flat round disc lying on the ground. A cylinder's length runs along X, so
-- tilting it 90 degrees on Z lays it flat and Size.X becomes its thickness.
function MapKit.disc(name: string, center: Vector3, diameter: number, thickness: number, look, parent: Instance): BasePart
	return MapKit.part(MapKit.with(look, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, diameter, diameter),
		Position = center,
		Orientation = Vector3.new(0, 0, 90),
	}), parent)
end

-- A cylinder ("limb") running from one point to another: trunks, branches, antlers, roots.
function MapKit.limb(name: string, from: Vector3, to: Vector3, thickness: number, look, parent: Instance): BasePart
	local middle = (from + to) / 2
	-- lookAt points -Z along the limb; turning 90 degrees on Y lines the cylinder's X axis up with it.
	local cframe = CFrame.lookAt(middle, to) * CFrame.Angles(0, math.pi / 2, 0)
	return MapKit.part(MapKit.with(look, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new((to - from).Magnitude, thickness, thickness),
		CFrame = cframe,
	}), parent)
end

-- A four-sided pyramid made of four corner wedges, standing on `baseCenter`.
-- Used for the layers of the pine trees. `yaw` turns it (radians).
function MapKit.pyramid(name: string, baseCenter: Vector3, base: number, height: number, yaw: number, look, parent: Instance)
	local origin = CFrame.new(baseCenter) * CFrame.Angles(0, yaw, 0)
	for quarter = 0, 3 do
		-- A corner wedge's peak is at its (+X, -Z) top corner; this offset puts that
		-- corner at the middle of the pyramid, then each copy is turned 90 degrees.
		local cframe = origin * CFrame.Angles(0, quarter * math.pi / 2, 0) * CFrame.new(-base / 4, height / 2, base / 4)
		MapKit.part(MapKit.with(look, {
			Name = name,
			Size = Vector3.new(base / 2, height, base / 2),
			CFrame = cframe,
		}), parent, "CornerWedgePart")
	end
end

-- A generated Model. `persistent` keeps it loaded on every client (needed for lamps).
function MapKit.model(name: string, parent: Instance, persistent: boolean?): Model
	local model = Instance.new("Model")
	model.Name = name
	if persistent then
		model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end
	model:SetAttribute(MapKit.GENERATED, true)
	model.Parent = parent
	return model
end

-- Finds a folder by name, or creates it. Folders are never deleted, so anything
-- you put inside them is safe.
function MapKit.folder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder
end

function MapKit.clearGenerated(container: Instance)
	for _, item in container:GetDescendants() do
		if item.Parent and item:GetAttribute(MapKit.GENERATED) then
			item:Destroy()
		end
	end
end

-- Adds a light, particle emitter or sound to a part. `props` sets its properties.
function MapKit.add(className: string, props, parent: Instance): Instance
	local item = Instance.new(className)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

return MapKit
]]></ProtectedString>
					<string name="ScriptGuid">{11B17594-0EF6-4F6B-91AD-FFE718554BD0}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MapKit</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00006009</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX64A50FC3B2084AEE9E88F3C71ABD151B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MapNature: the natural parts of the map - terrain ground, trails, hills, the pine
-- forest, rocks, and the dressing of each area (grove roots and flowers, marsh puddles
-- and reeds, the split pine on the ridge).

local ServerStorage = game:GetService("ServerStorage")
local Tools = ServerStorage.Tools
local MapConfig = require(Tools.MapConfig:Clone())
local MapKit = require(Tools.MapKit:Clone())

local COLOR = MapConfig.Color
local FOREST = MapConfig.Forest
local BOUNDS = MapConfig.Bounds
local TRAIL = MapConfig.Trail

local MapNature = {}

--------------------------------------------------------------------------------
-- Terrain
--------------------------------------------------------------------------------

-- Repaints part of the ground's top layer from one material to another.
local function paint(min: Vector3, max: Vector3, from: Enum.Material, to: Enum.Material)
	local region = Region3.new(min, max):ExpandToGrid(4)
	workspace.Terrain:ReplaceMaterial(region, 4, from, to)
end

-- Repaints a round patch of ground (whatever grass or dirt is there) without changing
-- its height, one 4x4-stud terrain cell at a time.
local GROUND_MATERIALS = { Enum.Material.Grass, Enum.Material.LeafyGrass, Enum.Material.Ground }
local function paintCircle(x: number, z: number, radius: number, to: Enum.Material)
	for cx = math.floor((x - radius) / 4) * 4, x + radius, 4 do
		for cz = math.floor((z - radius) / 4) * 4, z + radius, 4 do
			if Vector2.new(cx + 2 - x, cz + 2 - z).Magnitude <= radius then
				for _, from in GROUND_MATERIALS do
					paint(Vector3.new(cx, -8, cz), Vector3.new(cx + 4, 0, cz + 4), from, to)
				end
			end
		end
	end
end

-- Ground (top at Y = 0), dirt trails, painted patch areas and grassy hills around the edge.
-- Note: this REPLACES all terrain in the place.
function MapNature.buildTerrain(rng: Random)
	local terrain = workspace.Terrain
	terrain:Clear()
	for material, color in MapConfig.TerrainColors do
		terrain:SetMaterialColor(material, color)
	end
	pcall(function()
		terrain.Decoration = true -- swaying grass blades on Grass terrain
	end)

	-- Smooth terrain's surface sits 2 studs above the top of a filled block, so the
	-- block's top is at -2 to put the walkable ground at Y = 0.
	local size = (BOUNDS.Backdrop + 8) * 2
	terrain:FillBlock(CFrame.new(0, -10, 0), Vector3.new(size, 16, size), Enum.Material.Grass)

	-- Trails: dirt down the middle with leafy edges.
	local w, l = TRAIL.HalfWidth, TRAIL.HalfLength
	paint(Vector3.new(-w - 4, -8, -l), Vector3.new(w + 4, 0, l), Enum.Material.Grass, Enum.Material.LeafyGrass)
	paint(Vector3.new(-l, -8, -w - 4), Vector3.new(l, 0, w + 4), Enum.Material.Grass, Enum.Material.LeafyGrass)
	paint(Vector3.new(-w, -8, -l), Vector3.new(w, 0, l), Enum.Material.LeafyGrass, Enum.Material.Ground)
	paint(Vector3.new(-l, -8, -w), Vector3.new(l, 0, w), Enum.Material.LeafyGrass, Enum.Material.Ground)
	paintCircle(0, 0, 15, Enum.Material.Ground) -- trampled camp clearing
	for _, area in MapConfig.Areas do
		paintCircle(area.X, area.Z, MapConfig.AreaDiameter / 2, area.Material)
	end

	-- Rolling hills just outside the walls frame the map and hide its edge.
	local ring = BOUNDS.Wall + 14
	for t = -BOUNDS.Backdrop, BOUNDS.Backdrop, 14 do
		for _, spot in { Vector2.new(t, -ring), Vector2.new(t, ring), Vector2.new(-ring, t), Vector2.new(ring, t) } do
			local radius = rng:NextNumber(14, 24)
			local material = rng:NextNumber() < 0.25 and Enum.Material.Rock or Enum.Material.Grass
			terrain:FillBall(Vector3.new(spot.X, -radius * 0.45, spot.Y), radius, material)
		end
	end
end

--------------------------------------------------------------------------------
-- Trees and rocks
--------------------------------------------------------------------------------

-- Builds the list of keep-out circles: hand-written ones plus safe zones, areas,
-- mushroom spots and lamps.
local function buildKeepout()
	local keepout = table.clone(MapConfig.Keepout)
	for _, zone in MapConfig.SafeZones do
		table.insert(keepout, { X = zone.X, Z = zone.Z, Radius = zone.Diameter / 2 + 4 })
	end
	for _, area in MapConfig.Areas do
		table.insert(keepout, { X = area.X, Z = area.Z, Radius = MapConfig.AreaDiameter / 2 + 1 })
	end
	for _, spawn in MapConfig.MushroomSpawns do
		table.insert(keepout, { X = spawn.X, Z = spawn.Z, Radius = 5 })
	end
	for _, spoke in MapConfig.Lamps.Spokes do
		for _, distance in MapConfig.Lamps.Distances do
			local onTrail = spoke.Direction * distance
			table.insert(keepout, { X = onTrail.X, Z = onTrail.Y, Radius = MapConfig.Lamps.SideOffset + 3 })
		end
	end
	return keepout
end

-- True if a trunk at (x, z) stays clear of the trails and every keep-out circle.
local function isSpotClear(x: number, z: number, keepout): boolean
	local margin = TRAIL.HalfWidth + FOREST.TrailGap
	local onNorthSouthTrail = math.abs(x) < margin and math.abs(z) < TRAIL.HalfLength + FOREST.TrailGap
	local onEastWestTrail = math.abs(z) < margin and math.abs(x) < TRAIL.HalfLength + FOREST.TrailGap
	if onNorthSouthTrail or onEastWestTrail then
		return false
	end
	for _, zone in keepout do
		if Vector2.new(x - zone.X, z - zone.Z).Magnitude < zone.Radius then
			return false
		end
	end
	return true
end

-- A dark pine: a trunk and three stacked pyramids, each turned a little differently.
local function makePine(x: number, z: number, scale: number, rng: Random, parent: Instance)
	local tree = MapKit.model("Pine", parent)
	local trunkLook = { Material = Enum.Material.Wood, Color = COLOR.DarkWood }
	local trunkHeight = 15 * scale
	tree.PrimaryPart = MapKit.limb("Trunk", Vector3.new(x, -1, z), Vector3.new(x, trunkHeight, z), 1.6 * scale, trunkLook, tree)

	local green = COLOR.PineGreens[rng:NextInteger(1, #COLOR.PineGreens)]
	local layers = { -- { width, height, bottom }
		{ 12, 8.5, 4 },
		{ 9.5, 7.5, 8.5 },
		{ 6.5, 6.5, 12.5 },
	}
	for i, layer in layers do
		local look = { Material = Enum.Material.Grass, Color = green:Lerp(Color3.new(1, 1, 1), (i - 1) * 0.03), CastShadow = true }
		local base = Vector3.new(x, layer[3] * scale, z)
		MapKit.pyramid("Needles", base, layer[1] * scale, layer[2] * scale, rng:NextNumber(0, math.pi / 2), look, tree)
	end
end

-- A dead, leaning tree with crooked bare branches - a spooky silhouette in the fog.
local function makeDeadTree(x: number, z: number, scale: number, rng: Random, parent: Instance, lean: Vector3?)
	local tree = MapKit.model("DeadTree", parent)
	local look = { Material = Enum.Material.Wood, Color = COLOR.DeadWood }
	local base = Vector3.new(x, -1, z)
	local top = base + Vector3.new(0, 17 * scale, 0) + (lean or Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)))
	tree.PrimaryPart = MapKit.limb("Trunk", base, top, 1.5 * scale, look, tree)

	for _ = 1, rng:NextInteger(3, 5) do
		local start = base:Lerp(top, rng:NextNumber(0.45, 0.9))
		local angle = rng:NextNumber(0, math.pi * 2)
		local length = rng:NextNumber(4, 7) * scale
		local direction = Vector3.new(math.cos(angle), rng:NextNumber(0.5, 1.1), math.sin(angle)).Unit
		local tip = start + direction * length
		MapKit.limb("Branch", start, tip, 0.55 * scale, look, tree)
		-- a small twig off the end makes it look less straight
		local twig = tip + Vector3.new(rng:NextNumber(-1.5, 1.5), rng:NextNumber(0.8, 2), rng:NextNumber(-1.5, 1.5)) * scale
		MapKit.limb("Twig", tip, twig, 0.3 * scale, look, tree)
	end
	return tree
end
MapNature.makeDeadTree = makeDeadTree

-- Scatters trees on a jittered grid, inside the playable area and as a backdrop beyond the walls.
function MapNature.buildForest(parent: Instance, rng: Random): number
	local keepout = buildKeepout()
	local placed = {}
	local function farFromOthers(spot: Vector2): boolean
		for _, other in placed do
			if (other - spot).Magnitude < FOREST.Spacing then
				return false
			end
		end
		return true
	end

	local cell = FOREST.CellSize
	for gx = -BOUNDS.Backdrop, BOUNDS.Backdrop - cell, cell do
		for gz = -BOUNDS.Backdrop, BOUNDS.Backdrop - cell, cell do
			local x = gx + rng:NextNumber(0, cell)
			local z = gz + rng:NextNumber(0, cell)
			local edge = math.max(math.abs(x), math.abs(z))
			local inside = edge <= BOUNDS.Playable
			local backdrop = edge >= BOUNDS.Wall + 3
			local chance = backdrop and 0.85 or FOREST.Chance
			local scale = rng:NextNumber(FOREST.ScaleMin, FOREST.ScaleMax)
			local roll = rng:NextNumber()
			if (inside or backdrop) and roll < chance and (backdrop or isSpotClear(x, z, keepout)) then
				local spot = Vector2.new(x, z)
				if farFromOthers(spot) then
					table.insert(placed, spot)
					if inside and rng:NextNumber() < FOREST.DeadTreeChance then
						makeDeadTree(x, z, scale, rng, parent)
					else
						makePine(x, z, backdrop and scale * 1.2 or scale, rng, parent)
					end
					if #placed % 25 == 0 then
						task.wait() -- let Studio breathe while building hundreds of parts
					end
				end
			end
		end
	end

	-- Rocks: half-buried terrain boulders between the trees.
	for _ = 1, FOREST.RockCount do
		local x = rng:NextNumber(-BOUNDS.Playable, BOUNDS.Playable)
		local z = rng:NextNumber(-BOUNDS.Playable, BOUNDS.Playable)
		if isSpotClear(x, z, keepout) then
			local radius = rng:NextNumber(1.2, 2.8)
			workspace.Terrain:FillBall(Vector3.new(x, -radius * 0.35, z), radius, Enum.Material.Rock)
		end
	end
	return #placed
end

--------------------------------------------------------------------------------
-- Area dressing
--------------------------------------------------------------------------------

-- West Grove: thick roots around the big stump and pale flowers.
local function dressGrove(parent: Instance, rng: Random)
	local stump = Vector3.new(-95, 0, -16)
	local rootLook = { Material = Enum.Material.Wood, Color = COLOR.Wood }
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local from = stump + direction * 3.5 + Vector3.new(0, 1.6, 0)
		local to = stump + direction * rng:NextNumber(7, 9) + Vector3.new(0, -0.4, 0)
		MapKit.limb("Root", from, to, rng:NextNumber(0.9, 1.4), rootLook, parent)
	end

	local petals = { Color3.fromRGB(228, 222, 240), Color3.fromRGB(205, 225, 235), Color3.fromRGB(235, 228, 210) }
	local stemLook = { Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(70, 100, 70), CanCollide = false, CastShadow = false }
	local placed = 0
	while placed < 28 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local spot = Vector3.new(-95, 0, 0) + Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(4, 16)
		if math.abs(spot.Z) > 7 then -- not on the trail
			placed += 1
			local height = rng:NextNumber(0.6, 1.2)
			MapKit.part(MapKit.with(stemLook, { Name = "Stem", Size = Vector3.new(0.12, height, 0.12), Position = spot + Vector3.new(0, height / 2, 0) }), parent)
			MapKit.part({
				Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(0.35, 0.55),
				Position = spot + Vector3.new(0, height, 0), Material = Enum.Material.SmoothPlastic,
				Color = petals[rng:NextInteger(1, #petals)], CanCollide = false, CastShadow = false,
			}, parent)
		end
	end
end

-- East Marsh: still puddles that catch the light, clumps of reeds and a leaning dead tree.
local function dressMarsh(parent: Instance, rng: Random)
	local puddles = { { 87, 11, 8 }, { 101, 13, 6 }, { 89, -13, 9 }, { 101, -21, 6 }, { 113, 5, 7 }, { 82, -22, 5 } }
	local waterLook = { Material = Enum.Material.Glass, Color = Color3.fromRGB(30, 55, 70), Transparency = 0.15, Reflectance = 0.35, CanCollide = false, CastShadow = false }
	local reedLook = { Material = Enum.Material.Grass, Color = Color3.fromRGB(86, 96, 62), CanCollide = false }
	for i, puddle in puddles do
		local center = Vector3.new(puddle[1], 0.06, puddle[2])
		MapKit.disc("Puddle" .. i, center, puddle[3], 0.1, waterLook, parent)
		for _ = 1, rng:NextInteger(4, 7) do
			local angle = rng:NextNumber(0, math.pi * 2)
			local foot = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (puddle[3] / 2 + rng:NextNumber(0, 1.2))
			local tip = foot + Vector3.new(rng:NextNumber(-0.6, 0.6), rng:NextNumber(2.5, 4.5), rng:NextNumber(-0.6, 0.6))
			MapKit.limb("Reed", foot, tip, 0.18, reedLook, parent)
		end
	end
	makeDeadTree(97, 16, 1.35, rng, parent, Vector3.new(-5, 0, 2))
end

-- North Ridge: a big pine split into two trunks, and rocky outcrops.
local function dressRidge(parent: Instance, rng: Random)
	local tree = MapKit.model("SplitPine", parent)
	local trunkLook = { Material = Enum.Material.Wood, Color = COLOR.DarkWood }
	local base = Vector3.new(22, -1, -90)
	local tops = { Vector3.new(17, 20, -93), Vector3.new(28, 18, -86) }
	for i, top in tops do
		MapKit.limb("Trunk" .. i, base, top, 2.2, trunkLook, tree)
		local look = { Material = Enum.Material.Grass, Color = COLOR.PineGreens[i] }
		MapKit.pyramid("Needles", top - Vector3.new(0, 9, 0), 10, 8, rng:NextNumber(0, 1.5), look, tree)
		MapKit.pyramid("Needles", top - Vector3.new(0, 4, 0), 7, 7, rng:NextNumber(0, 1.5), look, tree)
	end
	for _, rock in { { -12, -108, 5 }, { 18, -113, 4 }, { -22, -100, 3.5 }, { 12, -82, 2.5 } } do
		workspace.Terrain:FillBall(Vector3.new(rock[1], -rock[3] * 0.3, rock[2]), rock[3], Enum.Material.Slate)
	end
end

function MapNature.dressAreas(map: Instance, rng: Random)
	dressGrove(MapKit.folder(map, "WestGrove"), rng)
	dressMarsh(MapKit.folder(map, "EastMarsh"), rng)
	dressRidge(MapKit.folder(map, "NorthRidge"), rng)
end

return MapNature
]]></ProtectedString>
					<string name="ScriptGuid">{639432FB-05A5-498D-A70A-702599334829}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MapNature</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000600b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3301E29D0A794108BC125B78C23D51F3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MapProps: the built objects of the map - the ranger camp, landmarks, trailhead,
-- path lamps, the safe lights (with their standing stones and beacon), spawn markers,
-- invisible boundary walls, and the starting night lighting seen in Studio.
--
-- Safe-light pieces that should only appear from the Warning onward are tagged
-- "SafeGlow" (CollectionService); the client's LightingController shows and hides them.

local Lighting = game:GetService("Lighting")
local ServerStorage = game:GetService("ServerStorage")
local Tools = ServerStorage.Tools
local MapConfig = require(Tools.MapConfig:Clone())
local MapKit = require(Tools.MapKit:Clone())

local COLOR = MapConfig.Color
local SAFE = MapConfig.SafeLight

local MapProps = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- A SurfaceGui sign: `lines` are { text, size } pairs written on the front (-Z) face.
local function writeSign(part: BasePart, lines)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0.7
	gui.PixelsPerStud = 40
	gui.Parent = part
	local layout = Instance.new("UIListLayout")
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = gui
	for _, line in lines do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, line[2], 0)
		label.Font = Enum.Font.Fondamento
		label.Text = line[1]
		label.TextScaled = true
		label.TextColor3 = rgb(225, 210, 175)
		label.Parent = gui
	end
end

--------------------------------------------------------------------------------
-- Camp
--------------------------------------------------------------------------------

-- The old ranger cabin: plank walls with a doorway and window, and a broken roof.
local function buildCabin(parent: Instance)
	local cabin = MapKit.model("RangerCabin", parent)
	local plank = { Material = Enum.Material.WoodPlanks, Color = COLOR.DarkWood }
	local wood = { Material = Enum.Material.Wood, Color = COLOR.Wood }
	local function wall(name, size, position)
		return MapKit.part(MapKit.with(plank, { Name = name, Size = size, Position = position }), cabin)
	end
	-- The cabin spans X -28..-12 and Z -24..-12; walls are 8 tall.
	MapKit.part(MapKit.with(wood, { Name = "Floor", Size = Vector3.new(16, 0.6, 12), Position = Vector3.new(-20, 0.3, -18) }), cabin)
	wall("BackWall", Vector3.new(16, 8, 0.8), Vector3.new(-20, 4, -23.6))
	wall("WestWall", Vector3.new(0.8, 8, 12), Vector3.new(-27.6, 4, -18))
	wall("EastWallLow", Vector3.new(0.8, 3, 12), Vector3.new(-12.4, 1.5, -18))
	wall("EastWallTop", Vector3.new(0.8, 2, 12), Vector3.new(-12.4, 7, -18))
	wall("EastWallSideA", Vector3.new(0.8, 3, 4), Vector3.new(-12.4, 4.5, -22))
	wall("EastWallSideB", Vector3.new(0.8, 3, 4), Vector3.new(-12.4, 4.5, -14)) -- leaves a window in the middle
	wall("FrontWallLeft", Vector3.new(6, 8, 0.8), Vector3.new(-25, 4, -12.4))
	wall("FrontWallRight", Vector3.new(5, 5, 0.8), Vector3.new(-14.5, 2.5, -12.4)) -- broken: shorter
	wall("Lintel", Vector3.new(5, 1.2, 0.8), Vector3.new(-19.5, 7.4, -12.4)) -- doorway below

	-- Gable roof: two wedges meeting at a ridge along X. The south half has a hole.
	local roof = { Material = Enum.Material.WoodPlanks, Color = rgb(48, 36, 30) }
	MapKit.part(MapKit.with(roof, { Name = "RoofNorth", Size = Vector3.new(17.5, 4.5, 6.8), Position = Vector3.new(-20, 10.25, -21.4) }), cabin, "WedgePart")
	MapKit.part(MapKit.with(roof, { Name = "RoofSouth", Size = Vector3.new(10, 4.5, 6.8), Position = Vector3.new(-23.7, 10.25, -14.6), Orientation = Vector3.new(0, 180, 0) }), cabin, "WedgePart")
	MapKit.part(MapKit.with(wood, { Name = "FallenBeam", Size = Vector3.new(0.6, 0.6, 9), Position = Vector3.new(-15, 3.2, -16), Orientation = Vector3.new(35, 10, 0) }), cabin)
	MapKit.part({ Name = "Chimney", Size = Vector3.new(2.2, 13, 2.2), Position = Vector3.new(-27, 6.5, -21.5), Material = Enum.Material.Cobblestone, Color = COLOR.Stone }, cabin)
end

local function buildCamp(map: Instance)
	local camp = MapKit.folder(map, "Camp")
	buildCabin(camp)

	local crate = { Material = Enum.Material.WoodPlanks, Color = COLOR.Wood }
	MapKit.part(MapKit.with(crate, { Name = "Crate", Size = Vector3.new(3, 3, 3), Position = Vector3.new(12, 1.5, -16) }), camp)
	MapKit.part(MapKit.with(crate, { Name = "Crate", Size = Vector3.new(3, 3, 3), Position = Vector3.new(15.5, 1.5, -15), Orientation = Vector3.new(0, 20, 0) }), camp)
	MapKit.part(MapKit.with(crate, { Name = "Crate", Size = Vector3.new(2.6, 2.6, 2.6), Position = Vector3.new(13.5, 4.3, -15.5), Orientation = Vector3.new(0, 10, 0) }), camp)
	MapKit.part({ Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.2, 2.4, 2.4), Position = Vector3.new(17, 1.6, -11), Orientation = Vector3.new(0, 0, 90), Material = Enum.Material.Wood, Color = rgb(80, 58, 40) }, camp)

	-- Map board facing the trailhead.
	local post = { Material = Enum.Material.Wood, Color = COLOR.DarkWood }
	MapKit.part(MapKit.with(post, { Name = "BoardPost", Size = Vector3.new(0.5, 6, 0.5), Position = Vector3.new(17.5, 3, 19) }), camp)
	MapKit.part(MapKit.with(post, { Name = "BoardPost", Size = Vector3.new(0.5, 6, 0.5), Position = Vector3.new(20.5, 3, 19) }), camp)
	local board = MapKit.part({ Name = "MapBoard", Size = Vector3.new(4.4, 3, 0.3), Position = Vector3.new(19, 4.2, 19.3), Orientation = Vector3.new(0, 180, 0), Material = Enum.Material.WoodPlanks, Color = rgb(120, 96, 66) }, camp)
	writeSign(board, { { "THE HOLLOW PINES", 0.3 }, { "N: Ridge   W: Grove   E: Marsh", 0.22 }, { "When the song stops, find the light.", 0.22 } })
end

--------------------------------------------------------------------------------
-- Landmarks and trailhead
--------------------------------------------------------------------------------

local function buildLandmarks(map: Instance)
	local log = { Material = Enum.Material.Wood, Color = COLOR.DarkWood }
	MapKit.part(MapKit.with(log, { Name = "FallenLog", Shape = Enum.PartType.Cylinder, Size = Vector3.new(20, 3.2, 3.2), Position = Vector3.new(-16, 1.4, -82), Orientation = Vector3.new(0, 25, 0) }), MapKit.folder(map, "NorthRidge"))
	MapKit.part({ Name = "BigStump", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 9, 9), Position = Vector3.new(-95, 1.8, -16), Orientation = Vector3.new(0, 0, 90), Material = Enum.Material.Wood, Color = COLOR.Wood }, MapKit.folder(map, "WestGrove"))

	local trailhead = MapKit.folder(map, "Trailhead")
	local beam = { Material = Enum.Material.Wood, Color = COLOR.DarkWood }
	MapKit.part(MapKit.with(beam, { Name = "GatePost", Size = Vector3.new(1.6, 13, 1.6), Position = Vector3.new(-8, 6.5, 85) }), trailhead)
	MapKit.part(MapKit.with(beam, { Name = "GatePost", Size = Vector3.new(1.6, 13, 1.6), Position = Vector3.new(8, 6.5, 85) }), trailhead)
	MapKit.part(MapKit.with(beam, { Name = "GateBeam", Size = Vector3.new(20, 1.6, 1.6), Position = Vector3.new(0, 12.4, 85), Orientation = Vector3.new(0, 0, -2) }), trailhead)
	local sign = MapKit.part({ Name = "GateSign", Size = Vector3.new(9, 2.2, 0.3), Position = Vector3.new(0, 10.4, 86), Orientation = Vector3.new(0, 180, 0), Material = Enum.Material.WoodPlanks, Color = rgb(110, 86, 60) }, trailhead)
	writeSign(sign, { { "THE HOLLOW PINES", 1 } })
	-- Warning sign beside the path, facing players who just spawned.
	MapKit.part(MapKit.with(beam, { Name = "SignPost", Size = Vector3.new(0.5, 5, 0.5), Position = Vector3.new(14, 2.5, 86.5) }), trailhead)
	local warning = MapKit.part({ Name = "WarningSign", Size = Vector3.new(4.5, 2.4, 0.25), Position = Vector3.new(14, 4.4, 86.3), Material = Enum.Material.WoodPlanks, Color = rgb(110, 86, 60), Orientation = Vector3.new(0, 180, -4) }, trailhead)
	writeSign(warning, { { "The forest listens", 0.4 }, { "to the song.", 0.4 } })

	MapKit.part({
		Name = "Spawn", Size = Vector3.new(6, 1, 6), Position = Vector3.new(0, 0.5, 95),
		Material = Enum.Material.Slate, Color = COLOR.Trail, Neutral = true, Transparency = 0.2,
	}, trailhead, "SpawnLocation")
end

--------------------------------------------------------------------------------
-- Path lamps
--------------------------------------------------------------------------------

-- A wooden post with an arm and a hanging glass lantern. The client's LightingController
-- finds the "Lantern" part (the glowing core) by name to switch it on and off.
local function makeLamp(name: string, position: Vector3, towardTrail: Vector3, parent: Instance)
	local lamp = MapKit.model(name, parent, true)
	local wood = { Material = Enum.Material.Wood, Color = COLOR.DarkWood }
	local metal = { Material = Enum.Material.Metal, Color = COLOR.Metal }
	lamp.PrimaryPart = MapKit.part(MapKit.with(wood, { Name = "Post", Size = Vector3.new(0.6, 9, 0.6), Position = position + Vector3.new(0, 4.5, 0) }), lamp)
	local armEnd = position + towardTrail * 1.8 + Vector3.new(0, 8.6, 0)
	MapKit.limb("Arm", position + Vector3.new(0, 8.6, 0), armEnd, 0.3, wood, lamp)
	local hang = armEnd - Vector3.new(0, 1.6, 0)
	MapKit.part(MapKit.with(metal, { Name = "Chain", Size = Vector3.new(0.08, 0.6, 0.08), Position = armEnd - Vector3.new(0, 0.3, 0) }), lamp)
	MapKit.pyramid("Cap", hang + Vector3.new(0, 0.8, 0), 1.4, 0.5, 0, metal, lamp)
	MapKit.part({ Name = "Cage", Size = Vector3.new(1.1, 1.5, 1.1), Position = hang, Material = Enum.Material.Glass, Color = rgb(255, 210, 160), Transparency = 0.55, CanCollide = false }, lamp)
	local lantern = MapKit.part({ Name = "Lantern", Size = Vector3.new(0.55, 0.85, 0.55), Position = hang, Material = Enum.Material.Neon, Color = MapConfig.Lamps.LanternColor, CanCollide = false, CastShadow = false }, lamp)
	MapKit.add("PointLight", { Brightness = 1.4, Range = 20, Color = MapConfig.Lamps.LanternColor, Shadows = true }, lantern)
end

local function buildPathLights(folder: Instance)
	local lamps = MapConfig.Lamps
	for _, spoke in lamps.Spokes do
		local side = Vector2.new(-spoke.Direction.Y, spoke.Direction.X) -- points across the trail
		for i, distance in lamps.Distances do
			local sign = (i % 2 == 1) and 1 or -1 -- alternate sides
			local spot = spoke.Direction * distance + side * lamps.SideOffset * sign
			local towardTrail = Vector3.new(-side.X * sign, 0, -side.Y * sign)
			makeLamp("PathLamp_" .. spoke.Name .. i, Vector3.new(spot.X, 0, spot.Y), towardTrail, folder)
		end
	end
end

--------------------------------------------------------------------------------
-- Safe lights
--------------------------------------------------------------------------------

-- One safe light: the zone disc (in Workspace.SafeZones, read by the server), a ring of
-- standing stones with glowing runes, and a beacon post whose flame lights the clearing.
-- Everything that glows is tagged "SafeGlow" and stays hidden until the Warning.
local function buildSafeLight(zone, safeZones: Instance, decorFolder: Instance, rng: Random)
	local center = Vector3.new(zone.X, 0, zone.Z)
	local radius = zone.Diameter / 2
	local glow = MapConfig.Color.SafeLight

	local disc = MapKit.disc(zone.Name, center + Vector3.new(0, 0.15, 0), zone.Diameter, 0.3, {
		Material = Enum.Material.Neon, Color = glow, Transparency = SAFE.FloorGlowTransparency,
		CanCollide = false, CanQuery = false, CastShadow = false, Tag = "SafeGlow",
	}, safeZones)
	disc:SetAttribute("GlowTransparency", SAFE.FloorGlowTransparency)

	local decor = MapKit.model(zone.Name .. "_Decor", decorFolder, true)
	local stone = { Material = Enum.Material.Slate, Color = COLOR.Stone }
	for i = 1, zone.Stones do
		local angle = (i / zone.Stones) * math.pi * 2
		local spot = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (radius + 1)
		local height = rng:NextNumber(2.2, 3.4)
		local facing = CFrame.lookAt(spot, center) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-6, 6)))
		local stonePart = MapKit.part(MapKit.with(stone, { Name = "Stone", Size = Vector3.new(1.4, height, 0.9), CFrame = facing + Vector3.new(0, height / 2 - 0.3, 0) }), decor)
		local rune = MapKit.part({
			Name = "Rune", Size = Vector3.new(0.45, 0.9, 0.05), CFrame = stonePart.CFrame * CFrame.new(0, 0.3, -0.48),
			Material = Enum.Material.Neon, Color = glow, Transparency = 0, CanCollide = false, CastShadow = false, Tag = "SafeGlow",
		}, decor)
		rune:SetAttribute("GlowTransparency", 0)
	end

	-- Beacon: a carved post with a warm flame on top. Its light is what lights the clearing.
	-- The post stands beside the trail, not on it (zones sit on the trails).
	local offset = if zone.Name == "SafeZone_Camp" then Vector3.new(-7, 0, 7) elseif zone.X == 0 then Vector3.new(8, 0, 0) else Vector3.new(0, 0, 8)
	local postSpot = center + offset
	MapKit.part({ Name = "BeaconPost", Size = Vector3.new(0.8, SAFE.BeaconHeight, 0.8), Position = postSpot + Vector3.new(0, SAFE.BeaconHeight / 2, 0), Material = Enum.Material.Wood, Color = COLOR.DarkWood }, decor)
	MapKit.part({ Name = "Bowl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 2.2, 2.2), Position = postSpot + Vector3.new(0, SAFE.BeaconHeight + 0.2, 0), Orientation = Vector3.new(0, 0, 90), Material = Enum.Material.Metal, Color = COLOR.Metal }, decor)
	local flame = MapKit.part({
		Name = "Flame", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.4, Position = postSpot + Vector3.new(0, SAFE.BeaconHeight + 1, 0),
		Material = Enum.Material.Neon, Color = glow, CanCollide = false, CastShadow = false, Tag = "SafeGlow",
	}, decor)
	flame:SetAttribute("GlowTransparency", 0)
	MapKit.add("PointLight", { Brightness = SAFE.LightBrightness, Range = SAFE.LightRange, Color = glow, Shadows = true }, flame)
	MapKit.add("Sound", { Name = "Hum", SoundId = "rbxassetid://9119032767", Looped = true, Volume = 0.18, RollOffMaxDistance = 45, RollOffMinDistance = 8 }, flame)

	-- Fireflies drifting over the whole clearing (from an invisible box).
	local swarm = MapKit.part({
		Name = "Fireflies", Size = Vector3.new(zone.Diameter - 4, 5, zone.Diameter - 4), Position = center + Vector3.new(0, 3, 0),
		Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Tag = "SafeGlow",
	}, decor)
	swarm:SetAttribute("GlowTransparency", 1)
	MapKit.add("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(rgb(255, 230, 150)),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.25), NumberSequenceKeypoint.new(0.8, 0.25), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0.1),
		Lifetime = NumberRange.new(3, 5),
		Rate = zone.Diameter * 0.6,
		Speed = NumberRange.new(0.3, 1),
		SpreadAngle = Vector2.new(180, 180),
		RotSpeed = NumberRange.new(-30, 30),
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
	}, swarm)
end

local function buildSafeLights(safeZones: Instance, map: Instance, rng: Random)
	local decorFolder = MapKit.folder(map, "SafeLights")
	for _, zone in MapConfig.SafeZones do
		buildSafeLight(zone, safeZones, decorFolder, rng)
	end
end

--------------------------------------------------------------------------------
-- Markers, walls and lighting
--------------------------------------------------------------------------------

-- A marker is a 1-stud invisible cube resting on the ground; the server reads its position.
local function makeMarker(name: string, x: number, z: number, parent: Instance): BasePart
	return MapKit.part({
		Name = name, Size = Vector3.one, Position = Vector3.new(x, 0.5, z),
		Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
	}, parent)
end

local function buildMarkers(mushroomFolder: Instance, denFolder: Instance)
	for _, spawn in MapConfig.MushroomSpawns do
		makeMarker(spawn.Name, spawn.X, spawn.Z, mushroomFolder):SetAttribute("MushroomType", spawn.Type)
	end
	for _, den in MapConfig.MonsterDens do
		makeMarker(den.Name, den.X, den.Z, denFolder)
	end
end

-- Invisible walls around the playable area.
local function buildWalls(map: Instance)
	local walls = MapKit.folder(map, "Walls")
	local edge = MapConfig.Bounds.Wall
	local look = { Transparency = 1, CanQuery = false, Size = Vector3.new(edge * 2 + 4, 60, 2) }
	for i, cframe in { CFrame.new(0, 30, -edge), CFrame.new(0, 30, edge), CFrame.new(-edge, 30, 0) * CFrame.Angles(0, math.pi / 2, 0), CFrame.new(edge, 30, 0) * CFrame.Angles(0, math.pi / 2, 0) } do
		MapKit.part(MapKit.with(look, { Name = "Wall" .. i, CFrame = cframe }), walls)
	end
end

-- The night look you see in Studio while editing. During play, the client's
-- LightingController takes over and changes it per phase.
local function setupLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1
	Lighting.Ambient = rgb(30, 40, 45)
	Lighting.OutdoorAmbient = rgb(60, 88, 92)
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)
	atmosphere.Density = 0.4
	atmosphere.Offset = 0.1
	atmosphere.Color = rgb(60, 105, 105)
	atmosphere.Decay = rgb(25, 45, 50)
	atmosphere.Glare = 0
	atmosphere.Haze = 1
	local grade = Lighting:FindFirstChild("Grade") or Instance.new("ColorCorrectionEffect", Lighting)
	grade.Name = "Grade"
	grade.Contrast = 0.12
	grade.Saturation = -0.1
	grade.TintColor = rgb(220, 235, 240)
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect", Lighting)
	bloom.Intensity = 0.8
	bloom.Size = 30
	bloom.Threshold = 1.6
	local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if sunRays then
		sunRays.Enabled = false
	end
end

function MapProps.build(folders, rng: Random)
	buildCamp(folders.Map)
	buildLandmarks(folders.Map)
	buildPathLights(folders.PathLights)
	buildSafeLights(folders.SafeZones, folders.Map, rng)
	buildMarkers(folders.MushroomSpawns, folders.MonsterSpawns)
	buildWalls(folders.Map)
	setupLighting()
end

return MapProps
