						<string name="ScriptGuid">{A4D73DE7-9CCB-4CE0-AF26-556697DC3DEB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ClientMain</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00000c36</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEE54AF2FEC0F43BF90AA7010CA533BFB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- HUDController: draws the round HUD (phase + countdown, night number, warning banner,
-- a "SAFE" label while the server says you are inside a safe light, and a caught message).
-- It only DISPLAYS the round state that RoundService publishes on ReplicatedStorage;
-- it never decides anything about the game.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local PHASE_TEXT = {
	Lobby = "GET READY",
	Exploring = "GATHER",
	Warning = "FIND THE LIGHT",
	Blackout = "BLACKOUT",
	Release = "THE LIGHT RETURNS",
	Results = "DAWN",
}
local WARNING_MESSAGE = "The song is fading — find the light!"
local BANNER_SECONDS = 3
local TEXT_COLOR = Color3.fromRGB(235, 240, 230)
local WARNING_COLOR = Color3.fromRGB(255, 200, 110)
local SAFE_TEXT = "SAFE IN THE LIGHT"
local SAFE_COLOR = Color3.fromRGB(255, 225, 150)
local CAUGHT_TEXT = "Caught in the dark — spectating until next round"
local CAUGHT_FLASH_SECONDS = 0.8 -- a short fade from black, played once per catch

local HUDController = {}

-- Creates a transparent, auto-scaling text label. `props` sets position and size.
local function newLabel(name: string, props, parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = TEXT_COLOR
	label.TextStrokeTransparency = 0.4 -- dark outline keeps text readable on bright areas
	label.TextScaled = true
	for key, value in props do
		label[key] = value
	end
	label.Parent = parent
	return label
end

local function formatTime(seconds: number): string
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

function HUDController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "RoundHUD"
	gui.ResetOnSpawn = false -- keep the HUD when the character respawns
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local phaseLabel = newLabel("Phase", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.6, 0, 0, 36),
	}, gui)
	local nightLabel = newLabel("Night", {
		Position = UDim2.new(0, 16, 0, 8),
		Size = UDim2.new(0.25, 0, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, gui)
	local banner = newLabel("WarningBanner", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		Size = UDim2.new(0.8, 0, 0, 48),
		Text = WARNING_MESSAGE,
		TextColor3 = WARNING_COLOR,
		Visible = false,
	}, gui)
	local safeLabel = newLabel("Safe", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.new(0.4, 0, 0, 24),
		Text = SAFE_TEXT,
		TextColor3 = SAFE_COLOR,
		Visible = false,
	}, gui)

	local caughtLabel = newLabel("Caught", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(0.8, 0, 0, 30),
		Text = CAUGHT_TEXT,
		Visible = false,
	}, gui)
	local flash = Instance.new("Frame")
	flash.Name = "CaughtFlash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.new(0, 0, 0)
	flash.BackgroundTransparency = 1
	flash.ZIndex = 0 -- behind the text
	flash.Parent = gui

	-- The server sets "Safe" and "Caught" attributes on our Player; we only show them.
	local player = Players.LocalPlayer
	local function refreshSafe()
		safeLabel.Visible = player:GetAttribute("Safe") == true
	end
	local function refreshCaught()
		local caught = player:GetAttribute("Caught") == true
		if caught and not caughtLabel.Visible then
			flash.BackgroundTransparency = 0
			TweenService:Create(flash, TweenInfo.new(CAUGHT_FLASH_SECONDS), { BackgroundTransparency = 1 }):Play()
		end
		caughtLabel.Visible = caught
	end
	player:GetAttributeChangedSignal("Safe"):Connect(refreshSafe)
	player:GetAttributeChangedSignal("Caught"):Connect(refreshCaught)
	refreshSafe()
	refreshCaught()

	-- Recalculates the text from the current attributes.
	local function refresh()
		local phase = ReplicatedStorage:GetAttribute("Phase")
		if not phase then
			phaseLabel.Text = "Waiting for server..."
			return
		end
		local endsAt = ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0
		local remaining = math.max(0, math.ceil(endsAt - workspace:GetServerTimeNow()))
		phaseLabel.Text = (PHASE_TEXT[phase] or phase) .. " — " .. formatTime(remaining)
		phaseLabel.TextColor3 = (phase == "Warning" or phase == "Blackout") and WARNING_COLOR or TEXT_COLOR

		local cycle = ReplicatedStorage:GetAttribute("Cycle") or 0
		nightLabel.Visible = cycle > 0
		nightLabel.Text = ("NIGHT %d / %d"):format(cycle, GameConfig.CyclesPerRound)
	end

	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		refresh()
		if ReplicatedStorage:GetAttribute("Phase") == "Warning" then
			banner.Visible = true
			task.delay(BANNER_SECONDS, function()
				banner.Visible = false
			end)
		end
	end)

	-- Update the countdown a few times per second.
	task.spawn(function()
		while true do
			refresh()
			task.wait(0.25)
		end
	end)
end

return HUDController
]]></ProtectedString>
						<string name="ScriptGuid">{FFDB2DD0-3A4C-43F3-835E-15832B213B99}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">HUDController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000213a</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX9B8D65FA1F704DD4BC21D15F87E3E39F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- LightingController: changes the sky, fog, path lamps and safe-light circles to match
-- the round phase. It runs on each player's computer because lighting is purely visual:
-- it reacts to the Phase attribute that RoundService sets, and never decides anything.
-- (Safety in the dark is checked by the server's safe-zone code, not by these lights.)
--
-- Safe-light circles stay hidden until the Warning, so players can't just wait beside
-- them; they must remember where the refuges are and run when the song fades.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Looks for each phase. "Lighting" values go on the Lighting service, "Atmosphere"
-- values on its Atmosphere (which controls the fog).
local PRESETS = {
	Night = {
		Lighting = { ClockTime = 0, Brightness = 1, Ambient = rgb(30, 40, 45), OutdoorAmbient = rgb(60, 90, 95), ExposureCompensation = 0 },
		Atmosphere = { Density = 0.4, Offset = 0.1, Color = rgb(60, 105, 105), Decay = rgb(25, 45, 50), Haze = 1 },
	},
	Blackout = {
		Lighting = { ClockTime = 0, Brightness = 0.3, Ambient = rgb(14, 18, 22), OutdoorAmbient = rgb(28, 38, 44), ExposureCompensation = -0.25 },
		Atmosphere = { Density = 0.5, Offset = 0.1, Color = rgb(20, 32, 36), Decay = rgb(8, 14, 16), Haze = 1 },
	},
	Dawn = {
		Lighting = { ClockTime = 6.4, Brightness = 2, Ambient = rgb(90, 85, 80), OutdoorAmbient = rgb(150, 140, 125), ExposureCompensation = 0 },
		Atmosphere = { Density = 0.3, Offset = 0.2, Color = rgb(200, 190, 170), Decay = rgb(150, 130, 110), Haze = 0.5 },
	},
}
local PHASE_PRESET = {
	Lobby = "Night",
	Exploring = "Night",
	Warning = "Night",
	Blackout = "Blackout",
	Release = "Night",
	Results = "Dawn",
}
-- How long (seconds) the change into each phase takes. Blackout is a sharp cut.
local FADE_SECONDS = {
	Blackout = 0.3,
	Release = GameConfig.PhaseDurations.Release * GameConfig.TimeScale, -- fade up over the whole phase
	Results = 3,
}
local DEFAULT_FADE = 1.5

-- Safe-light circles are shown in GameConfig.SafeZonePhases (the same phases in which
-- the server protects players).
local SAFE_ZONE_PHASES = GameConfig.SafeZonePhases
local SAFE_ZONE_TRANSPARENCY = 0.5 -- how see-through a shown circle is (1 = invisible)
local SAFE_ZONE_REVEAL_SECONDS = 0.5

-- Warning flicker: each tick, every lamp has a chance to blink off. The chance grows
-- from MIN to MAX as the warning runs out, so flicker gets faster (but never strobes).
local FLICKER_TICK = 0.1
local FLICKER_MIN_CHANCE = 0.03
local FLICKER_MAX_CHANCE = 0.3

local LightingController = {}

local currentPhase: string? = nil
local pathLights: Folder
local safeZones: Folder
local rng = Random.new()

local function tweenTo(target: Instance, properties, seconds: number)
	TweenService:Create(target, TweenInfo.new(seconds, Enum.EasingStyle.Sine), properties):Play()
end

local function setLamp(lamp: Instance, on: boolean)
	local lantern = lamp:FindFirstChild("Lantern")
	if not lantern then
		return
	end
	lantern.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local light = lantern:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = on
	end
end

local function setAllLamps(on: boolean)
	for _, lamp in pathLights:GetChildren() do
		setLamp(lamp, on)
	end
end

-- Fades a safe-light circle in or out. Its light switches with it.
local function setSafeZone(disc: Instance, visible: boolean, fade: number)
	if not disc:IsA("BasePart") then
		return
	end
	tweenTo(disc, { Transparency = visible and SAFE_ZONE_TRANSPARENCY or 1 }, fade)
	local light = disc:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = visible
	end
end

local function setAllSafeZones(visible: boolean, fade: number)
	for _, disc in safeZones:GetChildren() do
		setSafeZone(disc, visible, fade)
	end
end

-- Runs while the phase is Warning; stops by itself when the phase changes.
local function flicker()
	local duration = GameConfig.PhaseDurations.Warning * GameConfig.TimeScale
	while currentPhase == "Warning" do
		local remaining = (ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0) - workspace:GetServerTimeNow()
		local progress = math.clamp(1 - remaining / duration, 0, 1)
		local chance = FLICKER_MIN_CHANCE + (FLICKER_MAX_CHANCE - FLICKER_MIN_CHANCE) * progress
		for _, lamp in pathLights:GetChildren() do
			setLamp(lamp, rng:NextNumber() > chance)
		end
		task.wait(FLICKER_TICK)
	end
end

-- Moves the scene to the look for `phase`. `instant` skips the fade (used on join).
local function applyPhase(phase: string, instant: boolean)
	currentPhase = phase
	local preset = PRESETS[PHASE_PRESET[phase] or "Night"]
	local fade = instant and 0 or (FADE_SECONDS[phase] or DEFAULT_FADE)

	tweenTo(Lighting, preset.Lighting, fade)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		tweenTo(atmosphere, preset.Atmosphere, fade)
	end

	setAllLamps(phase ~= "Blackout")
	local showSafeZones = SAFE_ZONE_PHASES[phase] == true
	local zoneFade = fade -- hide at the same speed as the lighting change...
	if showSafeZones and not instant then
		zoneFade = SAFE_ZONE_REVEAL_SECONDS -- ...but reveal quickly, so players can react
	end
	setAllSafeZones(showSafeZones, zoneFade)
	if phase == "Warning" then
		task.spawn(flicker)
	end
end

function LightingController.start()
	pathLights = workspace:WaitForChild("PathLights")
	safeZones = workspace:WaitForChild("SafeZones")
	-- Anything that loads in late (streaming) should match the current phase.
	pathLights.ChildAdded:Connect(function(lamp)
		setLamp(lamp, currentPhase ~= "Blackout")
	end)
	safeZones.ChildAdded:Connect(function(disc)
		setSafeZone(disc, SAFE_ZONE_PHASES[currentPhase] == true, 0)
	end)

	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		applyPhase(ReplicatedStorage:GetAttribute("Phase"), false)
	end)
	applyPhase(ReplicatedStorage:GetAttribute("Phase") or "Lobby", true)
end

return LightingController
]]></ProtectedString>
						<string name="ScriptGuid">{5F9A0776-951A-45CC-894A-D70E6057BE77}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">LightingController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00002c6e</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX7599F7C1E99A442C90DD54A97B87D849">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- SpectateController: while you are caught, the camera follows another player who is
-- still in the round. When the next round starts, your new character takes the camera
-- back automatically (Roblox's default camera does that on spawn).

local Players = game:GetService("Players")

local CHECK_INTERVAL = 1 -- seconds between "is the person I'm watching still playing?" checks

local SpectateController = {}

local player = Players.LocalPlayer

-- Returns the Humanoid of someone still playing (not caught, alive), or nil.
local function findSomeoneToWatch(): Humanoid?
	for _, other in Players:GetPlayers() do
		local humanoid = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
		if other ~= player and not other:GetAttribute("Caught") and humanoid and humanoid.Health > 0 then
			return humanoid
		end
	end
	return nil
end

local function spectate()
	local camera = workspace.CurrentCamera
	while player:GetAttribute("Caught") do
		local subject = camera.CameraSubject
		local watching = subject and subject:IsA("Humanoid") and subject.Parent ~= player.Character and subject.Health > 0
		if not watching then
			camera.CameraSubject = findSomeoneToWatch() or camera.CameraSubject
		end
		task.wait(CHECK_INTERVAL)
	end
end

function SpectateController.start()
	player:GetAttributeChangedSignal("Caught"):Connect(function()
		if player:GetAttribute("Caught") then
			task.spawn(spectate)
		end
	end)
end

return SpectateController
]]></ProtectedString>
