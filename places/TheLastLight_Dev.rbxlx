				<Item class="LocalScript" referent="RBX22AC17AA43D342029E28BA5760845456">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- ClientMain: the starting point for code that runs on each player's computer
-- (HUD, sounds, visual effects). Gameplay decisions stay on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local log = require(ReplicatedStorage.Shared.Log)
local HUDController = require(script.Parent.HUDController)
local NotifyController = require(script.Parent.NotifyController)
local AbilityController = require(script.Parent.AbilityController)
local LightingController = require(script.Parent.LightingController)
local AudioController = require(script.Parent.AudioController)
local EffectsController = require(script.Parent.EffectsController)
local SpectateController = require(script.Parent.SpectateController)
local LobbyController = require(script.Parent.LobbyController)
local ResultsController = require(script.Parent.ResultsController)

HUDController.start()
NotifyController.start()
AbilityController.start()
LightingController.start()
AudioController.start()
EffectsController.start()
SpectateController.start()
LobbyController.start()
ResultsController.start()
log("Client started")
]]></ProtectedString>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<token name="RunContext">0</token>
						<string name="ScriptGuid">{A4D73DE7-9CCB-4CE0-AF26-556697DC3DEB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ClientMain</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00000c36</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEE54AF2FEC0F43BF90AA7010CA533BFB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- HUDController: draws the round HUD:
--   top centre   phase name + countdown, and "SAFE IN THE LIGHT" under it while safe
--   upper left   night number, with one moon per night
--   upper right  your points
--   centre       the warning banner when the song fades
--   bottom       the caught message (with a short fade from black)
-- It only DISPLAYS what the server publishes (attributes and leaderstats); it never
-- decides anything about the game.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local UIStyle = require(script.Parent.UIStyle)

local PHASE_TEXT = {
	Lobby = "Get Ready",
	Exploring = "Gather",
	Warning = "Find the Light",
	Blackout = "Blackout",
	Release = "The Light Returns",
	Results = "Dawn",
}
local DANGER_PHASES = { Warning = true, Blackout = true } -- phase text turns warm/orange
local WARNING_MESSAGE = "The song is fading — find the light!"
local BANNER_SECONDS = 3
local SAFE_TEXT = "SAFE IN THE LIGHT"
local CAUGHT_TEXT = "Caught in the dark — spectating until next round"
local CAUGHT_FLASH_SECONDS = 0.8 -- a short fade from black, played once per catch
local MOON_ON = Color3.fromRGB(220, 230, 255)
local MOON_OFF = Color3.fromRGB(50, 60, 70)

local HUDController = {}

local player = Players.LocalPlayer

local function formatTime(seconds: number): string
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

local function fade(item: GuiObject, property: string, value: number, seconds: number)
	TweenService:Create(item, TweenInfo.new(seconds, Enum.EasingStyle.Sine), { [property] = value }):Play()
end

-- Top centre: phase name on the left, countdown on the right.
local function buildPhasePanel(gui: ScreenGui)
	local panel = UIStyle.panel("PhasePanel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(340, 50),
	}, gui)
	local phase = UIStyle.label("Phase", {
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -110, 1, -12),
		Font = UIStyle.TitleFont,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, panel)
	local timer = UIStyle.label("Timer", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 10),
		Size = UDim2.new(0, 80, 1, -20),
		TextXAlignment = Enum.TextXAlignment.Right,
	}, panel)
	return panel, phase, timer
end

-- Upper left: "NIGHT 2" and one moon per night (filled = reached).
local function buildNightPanel(gui: ScreenGui)
	local panel = UIStyle.panel("NightPanel", {
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.fromOffset(150, 50),
	}, gui)
	local label = UIStyle.label("Night", {
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, panel)
	local moons = {}
	for i = 1, GameConfig.CyclesPerRound do
		local moon = Instance.new("Frame")
		moon.Name = "Moon" .. i
		moon.Size = UDim2.fromOffset(12, 12)
		moon.Position = UDim2.fromOffset(12 + (i - 1) * 20, 30)
		moon.BorderSizePixel = 0
		moon.BackgroundColor3 = MOON_OFF
		Instance.new("UICorner", moon).CornerRadius = UDim.new(1, 0)
		moon.Parent = panel
		moons[i] = moon
	end
	return panel, label, moons
end

-- Upper right: points from leaderstats (set by the server).
local function buildPointsPanel(gui: ScreenGui)
	local panel = UIStyle.panel("PointsPanel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 10),
		Size = UDim2.fromOffset(130, 50),
	}, gui)
	UIStyle.label("Caption", {
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 14),
		Text = "POINTS",
		TextColor3 = UIStyle.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, panel)
	local value = UIStyle.label("Value", {
		Position = UDim2.fromOffset(12, 20),
		Size = UDim2.new(1, -24, 0, 24),
		Text = "0",
		TextColor3 = UIStyle.Warm,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, panel)

	task.spawn(function()
		local points = player:WaitForChild("leaderstats"):WaitForChild("Points")
		local function refresh()
			value.Text = tostring(points.Value)
		end
		points.Changed:Connect(refresh)
		refresh()
	end)
end

function HUDController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "RoundHUD"
	gui.ResetOnSpawn = false -- keep the HUD when the character respawns
	gui.Parent = player:WaitForChild("PlayerGui")

	local _, phaseLabel, timerLabel = buildPhasePanel(gui)
	local nightPanel, nightLabel, moons = buildNightPanel(gui)
	buildPointsPanel(gui)

	local banner = UIStyle.label("WarningBanner", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		Size = UDim2.new(0.8, 0, 0, 54),
		Font = UIStyle.TitleFont,
		Text = WARNING_MESSAGE,
		TextColor3 = UIStyle.Warm,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}, gui)
	local safeLabel = UIStyle.label("Safe", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(260, 22),
		Text = SAFE_TEXT,
		TextColor3 = UIStyle.Warm,
		Visible = false,
	}, gui)
	local caughtLabel = UIStyle.label("Caught", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(0.8, 0, 0, 30),
		Text = CAUGHT_TEXT,
		Visible = false,
	}, gui)
	local flash = Instance.new("Frame")
	flash.Name = "CaughtFlash"
	flash.Position = UDim2.fromOffset(0, -80) -- also covers Roblox's top bar
	flash.Size = UDim2.new(1, 0, 1, 80)
	flash.BackgroundColor3 = Color3.new(0, 0, 0)
	flash.BackgroundTransparency = 1
	flash.ZIndex = 0 -- behind the text
	flash.Parent = gui

	-- The server sets "Safe" and "Caught" attributes on our Player; we only show them.
	local function refreshSafe()
		safeLabel.Visible = player:GetAttribute("Safe") == true
	end
	local function refreshCaught()
		local caught = player:GetAttribute("Caught") == true
		if caught and not caughtLabel.Visible then
			flash.BackgroundTransparency = 0
			fade(flash, "BackgroundTransparency", 1, CAUGHT_FLASH_SECONDS)
		end
		caughtLabel.Visible = caught
	end
	player:GetAttributeChangedSignal("Safe"):Connect(refreshSafe)
	player:GetAttributeChangedSignal("Caught"):Connect(refreshCaught)
	refreshSafe()
	refreshCaught()

	-- Recalculates the text from the current round attributes.
	local function refresh()
		local phase = ReplicatedStorage:GetAttribute("Phase")
		if not phase then
			phaseLabel.Text = "Waiting..."
			timerLabel.Text = ""
			return
		end
		local endsAt = ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0
		local remaining = math.max(0, math.ceil(endsAt - workspace:GetServerTimeNow()))
		local color = DANGER_PHASES[phase] and UIStyle.Warm or UIStyle.Text
		phaseLabel.Text = PHASE_TEXT[phase] or phase
		phaseLabel.TextColor3 = color
		timerLabel.Text = formatTime(remaining)
		timerLabel.TextColor3 = color

		local cycle = ReplicatedStorage:GetAttribute("Cycle") or 0
		nightPanel.Visible = cycle > 0
		nightLabel.Text = ("NIGHT %d / %d"):format(cycle, GameConfig.CyclesPerRound)
		for i, moon in moons do
			moon.BackgroundColor3 = i <= cycle and MOON_ON or MOON_OFF
		end
	end

	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		refresh()
		if ReplicatedStorage:GetAttribute("Phase") == "Warning" then
			fade(banner, "TextTransparency", 0, 0.3)
			fade(banner, "TextStrokeTransparency", 0.5, 0.3)
			task.delay(BANNER_SECONDS, function()
				fade(banner, "TextTransparency", 1, 0.6)
				fade(banner, "TextStrokeTransparency", 1, 0.6)
			end)
		end
	end)

	-- Update the countdown a few times per second.
	task.spawn(function()
		while true do
			refresh()
			task.wait(0.25)
		end
	end)
end

return HUDController
]]></ProtectedString>
						<string name="ScriptGuid">{FFDB2DD0-3A4C-43F3-835E-15832B213B99}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">HUDController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000213a</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX9B8D65FA1F704DD4BC21D15F87E3E39F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- LightingController: changes the sky, fog, colour grading, path lamps and safe lights
-- to match the round phase. It runs on each player's computer because lighting is purely
-- visual: it reacts to the Phase attribute that RoundService sets, and never decides
-- anything. (Safety in the dark is checked by the server's safe-zone code.)
--
-- Safe lights stay hidden until the Warning, so players can't just wait beside them;
-- they must remember where the refuges are and run when the song fades. Every piece of
-- a safe light that glows (floor circle, runes, beacon flame, fireflies, hum) is tagged
-- "SafeGlow" by the map generator.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Looks for each phase. "Lighting" values go on the Lighting service, "Atmosphere" on
-- its Atmosphere (the fog) and "Grade" on the colour correction effect.
local PRESETS = {
	Night = {
		Lighting = { ClockTime = 0, Brightness = 1, Ambient = rgb(30, 40, 45), OutdoorAmbient = rgb(60, 88, 92), ExposureCompensation = 0 },
		Atmosphere = { Density = 0.4, Offset = 0.1, Color = rgb(60, 105, 105), Decay = rgb(25, 45, 50), Haze = 1 },
		Grade = { Brightness = 0, Contrast = 0.12, Saturation = -0.1, TintColor = rgb(220, 235, 240) },
	},
	-- Dark, but trees still stand out as silhouettes against slightly lighter fog.
	Blackout = {
		Lighting = { ClockTime = 0, Brightness = 0.3, Ambient = rgb(16, 20, 26), OutdoorAmbient = rgb(30, 40, 48), ExposureCompensation = -0.2 },
		Atmosphere = { Density = 0.45, Offset = 0.1, Color = rgb(30, 46, 54), Decay = rgb(12, 20, 24), Haze = 1 },
		Grade = { Brightness = -0.02, Contrast = 0.22, Saturation = -0.35, TintColor = rgb(195, 210, 230) },
	},
	Dawn = {
		Lighting = { ClockTime = 6.4, Brightness = 2, Ambient = rgb(90, 85, 80), OutdoorAmbient = rgb(150, 140, 125), ExposureCompensation = 0 },
		Atmosphere = { Density = 0.3, Offset = 0.2, Color = rgb(200, 190, 170), Decay = rgb(150, 130, 110), Haze = 0.5 },
		Grade = { Brightness = 0.02, Contrast = 0.05, Saturation = 0, TintColor = rgb(255, 240, 220) },
	},
}
local PHASE_PRESET = {
	Lobby = "Night",
	Exploring = "Night",
	Warning = "Night",
	Blackout = "Blackout",
	Release = "Night",
	Results = "Dawn",
}
-- How long (seconds) the change into each phase takes. Blackout is a sharp cut.
local FADE_SECONDS = {
	Blackout = 0.3,
	Release = GameConfig.PhaseDurations.Release * GameConfig.TimeScale, -- fade up over the whole phase
	Results = 3,
}
local DEFAULT_FADE = 1.5

-- Safe lights are shown in GameConfig.SafeZonePhases (the same phases in which the
-- server protects players).
local SAFE_ZONE_PHASES = GameConfig.SafeZonePhases
local SAFE_GLOW_TAG = "SafeGlow"
local SAFE_GLOW_REVEAL_SECONDS = 0.5

-- Warning flicker: each tick, every lamp has a chance to blink off. The chance grows
-- from MIN to MAX as the warning runs out, so flicker gets faster (but never strobes).
local FLICKER_TICK = 0.1
local FLICKER_MIN_CHANCE = 0.03
local FLICKER_MAX_CHANCE = 0.3

local LightingController = {}

local currentPhase: string? = nil
local pathLights: Folder
local rng = Random.new()

local function tweenTo(target: Instance, properties, seconds: number)
	TweenService:Create(target, TweenInfo.new(seconds, Enum.EasingStyle.Sine), properties):Play()
end

local function setLamp(lamp: Instance, on: boolean)
	local lantern = lamp:FindFirstChild("Lantern")
	if not lantern then
		return
	end
	lantern.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local light = lantern:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = on
	end
end

local function setAllLamps(on: boolean)
	for _, lamp in pathLights:GetChildren() do
		setLamp(lamp, on)
	end
end

-- Shows or hides one glowing piece of a safe light: the part fades to its
-- "GlowTransparency", and its lights, particles and sounds switch with it.
local function setGlow(item: Instance, visible: boolean, fade: number)
	if item:IsA("BasePart") then
		local shown = item:GetAttribute("GlowTransparency") or 0
		tweenTo(item, { Transparency = visible and shown or 1 }, fade)
	end
	for _, child in item:GetDescendants() do
		if child:IsA("Light") or child:IsA("ParticleEmitter") then
			child.Enabled = visible
		elseif child:IsA("Sound") then
			if visible and not child.IsPlaying then
				child:Play()
			elseif not visible then
				child:Stop()
			end
		end
	end
end

local function setAllSafeGlow(visible: boolean, fade: number)
	for _, item in CollectionService:GetTagged(SAFE_GLOW_TAG) do
		setGlow(item, visible, fade)
	end
end

-- Runs while the phase is Warning; stops by itself when the phase changes.
local function flicker()
	local duration = GameConfig.PhaseDurations.Warning * GameConfig.TimeScale
	while currentPhase == "Warning" do
		local remaining = (ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0) - workspace:GetServerTimeNow()
		local progress = math.clamp(1 - remaining / duration, 0, 1)
		local chance = FLICKER_MIN_CHANCE + (FLICKER_MAX_CHANCE - FLICKER_MIN_CHANCE) * progress
		for _, lamp in pathLights:GetChildren() do
			setLamp(lamp, rng:NextNumber() > chance)
		end
		task.wait(FLICKER_TICK)
	end
end

-- Moves the scene to the look for `phase`. `instant` skips the fade (used on join).
local function applyPhase(phase: string, instant: boolean)
	currentPhase = phase
	local preset = PRESETS[PHASE_PRESET[phase] or "Night"]
	local fade = instant and 0 or (FADE_SECONDS[phase] or DEFAULT_FADE)

	tweenTo(Lighting, preset.Lighting, fade)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		tweenTo(atmosphere, preset.Atmosphere, fade)
	end
	local grade = Lighting:FindFirstChild("Grade")
	if grade then
		tweenTo(grade, preset.Grade, fade)
	end

	setAllLamps(phase ~= "Blackout")
	local showSafeLights = SAFE_ZONE_PHASES[phase] == true
	local glowFade = fade -- hide at the same speed as the lighting change...
	if showSafeLights and not instant then
		glowFade = SAFE_GLOW_REVEAL_SECONDS -- ...but reveal quickly, so players can react
	end
	setAllSafeGlow(showSafeLights, glowFade)
	if phase == "Warning" then
		task.spawn(flicker)
	end
end

function LightingController.start()
	pathLights = workspace:WaitForChild("PathLights")
	-- Anything that loads in late (streaming) should match the current phase.
	pathLights.ChildAdded:Connect(function(lamp)
		setLamp(lamp, currentPhase ~= "Blackout")
	end)
	CollectionService:GetInstanceAddedSignal(SAFE_GLOW_TAG):Connect(function(item)
		setGlow(item, SAFE_ZONE_PHASES[currentPhase] == true, 0)
	end)

	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		applyPhase(ReplicatedStorage:GetAttribute("Phase"), false)
	end)
	applyPhase(ReplicatedStorage:GetAttribute("Phase") or "Lobby", true)
end

return LightingController
]]></ProtectedString>
						<string name="ScriptGuid">{5F9A0776-951A-45CC-894A-D70E6057BE77}</string>
