			<Item class="ModuleScript" referent="RBX21D3D5D2E06041CABFBDF90919B3EB00">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Log: prints a debug message, but only while GameConfig.Debug is true.
-- Usage: local log = require(ReplicatedStorage.Shared.Log); log("Something happened", value)

local GameConfig = require(script.Parent.GameConfig)

return function(...)
	if GameConfig.Debug then
		print("[TheLastLight]", ...)
	end
end
]]></ProtectedString>
