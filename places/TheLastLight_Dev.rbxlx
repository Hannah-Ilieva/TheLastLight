						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">LightingController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00002c6e</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX7599F7C1E99A442C90DD54A97B87D849">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- SpectateController: while you are caught, the camera follows another player who is
-- still in the round. When the next round starts, your new character takes the camera
-- back automatically (Roblox's default camera does that on spawn).

local Players = game:GetService("Players")

local CHECK_INTERVAL = 1 -- seconds between "is the person I'm watching still playing?" checks

local SpectateController = {}

local player = Players.LocalPlayer

-- Returns the Humanoid of someone still playing (not caught, alive), or nil.
local function findSomeoneToWatch(): Humanoid?
	for _, other in Players:GetPlayers() do
		local humanoid = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
		if other ~= player and not other:GetAttribute("Caught") and humanoid and humanoid.Health > 0 then
			return humanoid
		end
	end
	return nil
end

local function spectate()
	local camera = workspace.CurrentCamera
	while player:GetAttribute("Caught") do
		local subject = camera.CameraSubject
		local watching = subject and subject:IsA("Humanoid") and subject.Parent ~= player.Character and subject.Health > 0
		if not watching then
			camera.CameraSubject = findSomeoneToWatch() or camera.CameraSubject
		end
		task.wait(CHECK_INTERVAL)
	end
end

function SpectateController.start()
	player:GetAttributeChangedSignal("Caught"):Connect(function()
		if player:GetAttribute("Caught") then
			task.spawn(spectate)
		end
	end)
end

return SpectateController
]]></ProtectedString>
						<string name="ScriptGuid">{B30B6EDC-56A9-4767-A1CC-0EEC55B32647}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SpectateController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000449d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX51253DEF8CA046679002336A577490FE">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- UIStyle: the shared look of every on-screen element (fonts, colours) plus small helpers
-- to create labels and panels, so all the HUD pieces match.

local UIStyle = {
	TitleFont = Enum.Font.Fondamento, -- old-folklore style, for big headings
	BodyFont = Enum.Font.GothamMedium,
	BoldFont = Enum.Font.GothamBold,

	Text = Color3.fromRGB(235, 240, 230),
	Muted = Color3.fromRGB(165, 185, 180),
	Warm = Color3.fromRGB(255, 200, 110), -- warnings and safe light
	Panel = Color3.fromRGB(8, 14, 16),
	PanelTransparency = 0.3,
	Stroke = Color3.fromRGB(120, 160, 150),
}

-- Applies a table of properties to an instance and parents it.
local function apply(instance: Instance, props, parent: Instance)
	for key, value in props do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

-- A transparent, auto-scaling text label with a dark outline (readable on any background).
function UIStyle.label(name: string, props, parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = UIStyle.BoldFont
	label.TextColor3 = UIStyle.Text
	label.TextStrokeTransparency = 0.5
	label.TextScaled = true
	return apply(label, props, parent)
end

-- A dark, rounded, see-through panel with a thin outline. `strokeColor` is optional.
function UIStyle.panel(name: string, props, parent: Instance, strokeColor: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = UIStyle.Panel
	frame.BackgroundTransparency = UIStyle.PanelTransparency
	frame.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = strokeColor or UIStyle.Stroke
	stroke.Transparency = 0.4
	stroke.Thickness = 1.5
	stroke.Parent = frame
	return apply(frame, props, parent)
end

-- A clickable button with the same rounded, outlined look as the panels.
function UIStyle.button(name: string, props, parent: Instance): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.AutoButtonColor = true
	button.BackgroundColor3 = UIStyle.Panel
	button.BackgroundTransparency = UIStyle.PanelTransparency
	button.BorderSizePixel = 0
	button.Font = UIStyle.BoldFont
	button.TextColor3 = UIStyle.Text
	button.TextScaled = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = UIStyle.Stroke
	stroke.Transparency = 0.4
	stroke.Thickness = 1.5
	stroke.Parent = button
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 40) -- room for a colour swatch on the left
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = button
	return apply(button, props, parent)
end

return UIStyle
]]></ProtectedString>
						<string name="ScriptGuid">{58C0F944-17C9-42E3-99B3-B3495C2AE46C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">UIStyle</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad0000584e</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX951D6A58B83B4F3EA7401B91AA3D34A4">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- NotifyController: shows the short messages the server sends through the Notify remote
-- (mushroom pickups, powers, shield breaking, "hands full"). A new message replaces
-- the old one. Other client scripts can listen to NotifyController.shown, e.g. to play
-- a sound for each style.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIStyle = require(script.Parent.UIStyle)

local SHOW_SECONDS = 3
local FADE_SECONDS = 0.25
local STYLE_COLOR = {
	pickup = Color3.fromRGB(235, 225, 200),
	rare = Color3.fromRGB(255, 215, 140),
	power = Color3.fromRGB(255, 140, 70),
	shield = Color3.fromRGB(190, 140, 255),
	info = Color3.fromRGB(165, 185, 180),
}

local NotifyController = {}
local shownEvent = Instance.new("BindableEvent")
NotifyController.shown = shownEvent.Event -- fires (style, title, detail)

function NotifyController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Notifications"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local panel = UIStyle.panel("Toast", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(360, 64),
		Visible = false,
	}, gui)
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	local title = UIStyle.label("Title", {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 26),
		Font = UIStyle.TitleFont,
	}, panel)
	local detail = UIStyle.label("Detail", {
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.new(1, -28, 0, 18),
		Font = UIStyle.BodyFont,
		TextColor3 = UIStyle.Muted,
	}, panel)

	local showId = 0 -- lets an old "hide" timer know a newer message replaced it
	local function show(style: string, titleText: string, detailText: string?)
		showId += 1
		local myId = showId
		local color = STYLE_COLOR[style] or UIStyle.Text
		title.Text = titleText
		title.TextColor3 = color
		stroke.Color = color
		detail.Text = detailText or ""
		panel.Visible = true
		panel.Position = UDim2.new(0.5, 0, 1, -70)
		TweenService:Create(panel, TweenInfo.new(FADE_SECONDS, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 1, -90) }):Play()
		shownEvent:Fire(style, titleText, detailText)

		task.delay(SHOW_SECONDS, function()
			if showId == myId then
				panel.Visible = false
			end
		end)
	end

	ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Notify").OnClientEvent:Connect(show)
end

return NotifyController
]]></ProtectedString>
						<string name="ScriptGuid">{C6C6B021-7DD1-49DE-9B8B-C7B28704170F}</string>
