						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00005850</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX92CB1A20B2624380B5EC2661EBB176FB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- AbilityController: shows the power mushroom you carry (upper right, under your points)
-- and lets you use it: Q on keyboard, Y on a controller, or the on-screen button on
-- mobile. Pressing only SENDS A REQUEST; the server decides whether it works.
-- While a speed boost is active, the camera widens a little so the speed is felt.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MushroomConfig = require(ReplicatedStorage.Shared.MushroomConfig)
local UIStyle = require(script.Parent.UIStyle)

local ACTION_NAME = "UseAbility"
local KEYS = { Enum.KeyCode.Q, Enum.KeyCode.ButtonY }
local HINT = {
	Speed = "Press Q to use",
	Shield = "Blocks one catch",
}
local NORMAL_FOV = 70
local BOOST_FOV = 82

local AbilityController = {}

local player = Players.LocalPlayer

function AbilityController.start()
	local useAbility = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UseAbility")

	local gui = Instance.new("ScreenGui")
	gui.Name = "AbilityHUD"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local slot = UIStyle.panel("PowerSlot", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 68),
		Size = UDim2.fromOffset(200, 50),
		Visible = false,
	}, gui)
	local stroke = slot:FindFirstChildOfClass("UIStroke")
	local orb = Instance.new("Frame") -- a glowing dot in the mushroom's colour
	orb.Name = "Orb"
	orb.Position = UDim2.fromOffset(12, 13)
	orb.Size = UDim2.fromOffset(24, 24)
	orb.BorderSizePixel = 0
	Instance.new("UICorner", orb).CornerRadius = UDim.new(1, 0)
	orb.Parent = slot
	local nameLabel = UIStyle.label("PowerName", {
		Position = UDim2.fromOffset(46, 7),
		Size = UDim2.new(1, -56, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, slot)
	local hintLabel = UIStyle.label("Hint", {
		Position = UDim2.fromOffset(46, 28),
		Size = UDim2.new(1, -56, 0, 14),
		Font = UIStyle.BodyFont,
		TextColor3 = UIStyle.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, slot)

	local function onAction(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			useAbility:FireServer()
		end
		return Enum.ContextActionResult.Sink
	end

	-- Shows the carried power, and binds the key only when there is something to use.
	local function refreshPower()
		local config = MushroomConfig[player:GetAttribute("Power")]
		ContextActionService:UnbindAction(ACTION_NAME)
		slot.Visible = config ~= nil
		if not config then
			return
		end
		nameLabel.Text = config.DisplayName
		nameLabel.TextColor3 = config.GlowColor
		orb.BackgroundColor3 = config.GlowColor
		stroke.Color = config.GlowColor
		hintLabel.Text = HINT[config.Power] or ""
		if config.Power == "Speed" then
			ContextActionService:BindAction(ACTION_NAME, onAction, true, table.unpack(KEYS))
			ContextActionService:SetTitle(ACTION_NAME, "Speed")
			ContextActionService:SetPosition(ACTION_NAME, UDim2.new(1, -170, 1, -150))
		end
	end

	-- Widens the camera while the server says we are boosted.
	local function refreshBoost()
		local boosted = player:GetAttribute("BoostEndsAt") ~= nil
		local camera = workspace.CurrentCamera
		local info = TweenInfo.new(boosted and 0.25 or 0.8, Enum.EasingStyle.Sine)
		TweenService:Create(camera, info, { FieldOfView = boosted and BOOST_FOV or NORMAL_FOV }):Play()
	end

	player:GetAttributeChangedSignal("Power"):Connect(refreshPower)
	player:GetAttributeChangedSignal("BoostEndsAt"):Connect(refreshBoost)
	refreshPower()
end

return AbilityController
]]></ProtectedString>
						<string name="ScriptGuid">{FFED7ABC-47F9-4973-AA5A-CEF19EB7F12D}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">AbilityController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00005852</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1E6687DFED594133BAA19DEBF887476C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- AudioController: the game's soundtrack, following the round phase.
--   Gather    the music-box song plays over night insects
--   Warning   the song speeds up and a heartbeat joins, faster and faster
--   Blackout  the song cuts out; a moment of near silence, then a low drone
--   Release   the drone fades and the song starts again
--   Dawn      birds sing
-- It also plays short effects for pickups, powers and being caught. Sounds are created
-- on this computer only; nothing here affects gameplay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local SoundConfig = require(ReplicatedStorage.Shared.SoundConfig)
local NotifyController = require(script.Parent.NotifyController)

local SONG_WARNING_SPEED = 1.3 -- how fast the song gets by the end of the Warning
local HEARTBEAT_START_SPEED = 0.9
local HEARTBEAT_END_SPEED = 1.7
local SILENCE_BEFORE_DRONE = 0.8 -- seconds of near silence when the lights die
local STYLE_SOUND = { -- Notify style -> effect
	pickup = "Pickup",
	rare = "RarePickup",
	power = "SpeedBoost",
	shield = "ShieldBreak",
}

local AudioController = {}

local sounds: { [string]: Sound } = {}
local currentPhase: string? = nil

local function makeSound(name: string, looped: boolean): Sound
	local entry = SoundConfig[name]
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = "rbxassetid://" .. entry.Id
	sound.Volume = 0
	sound.Looped = looped
	sound.Parent = SoundService
	sounds[name] = sound
	return sound
end

-- Fades a looping sound to `level` (0-1 of its configured volume), starting or
-- stopping it as needed.
local function fadeTo(name: string, level: number, seconds: number)
	local sound = sounds[name]
	local target = SoundConfig[name].Volume * level
	if level > 0 and not sound.IsPlaying then
		sound:Play()
	end
	local tween = TweenService:Create(sound, TweenInfo.new(seconds), { Volume = target })
	tween:Play()
	if level == 0 then
		tween.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed and sound.Volume == 0 then
				sound:Stop()
			end
		end)
	end
end

local function playOnce(name: string)
	local sound = sounds[name]
	sound.Volume = SoundConfig[name].Volume
	sound.TimePosition = 0
	sound:Play()
end

local function setSpeed(name: string, speed: number, seconds: number)
	TweenService:Create(sounds[name], TweenInfo.new(seconds, Enum.EasingStyle.Linear), { PlaybackSpeed = speed }):Play()
end

local function onPhase(phase: string)
	currentPhase = phase
	local warningSeconds = GameConfig.PhaseDurations.Warning * GameConfig.TimeScale

	if phase == "Lobby" or phase == "Exploring" then
		fadeTo("Dawn", 0, 1.5)
		fadeTo("Ambience", 1, 2)
		fadeTo("Song", phase == "Lobby" and 0.6 or 1, 2)
		setSpeed("Song", 1, 1)
		fadeTo("Heartbeat", 0, 0.5)
	elseif phase == "Warning" then
		setSpeed("Song", SONG_WARNING_SPEED, warningSeconds)
		sounds.Heartbeat.PlaybackSpeed = HEARTBEAT_START_SPEED
		fadeTo("Heartbeat", 1, 1)
		setSpeed("Heartbeat", HEARTBEAT_END_SPEED, warningSeconds)
	elseif phase == "Blackout" then
		-- The music stops sharply. Silence is part of the scare.
		for _, name in { "Song", "Heartbeat" } do
			sounds[name].Volume = 0
			sounds[name]:Stop()
		end
		fadeTo("Ambience", 0.25, 0.3)
		task.delay(SILENCE_BEFORE_DRONE, function()
			if currentPhase == "Blackout" then
				fadeTo("BlackoutDrone", 1, 1.5)
			end
		end)
	elseif phase == "Release" then
		fadeTo("BlackoutDrone", 0, 1.5)
		fadeTo("Ambience", 1, 2)
		sounds.Song.TimePosition = 0
		sounds.Song.PlaybackSpeed = 1
		fadeTo("Song", 1, 2.5)
	elseif phase == "Results" then
		for _, name in { "Song", "Heartbeat", "BlackoutDrone", "Ambience" } do
			fadeTo(name, 0, 2)
		end
		fadeTo("Dawn", 1, 3)
	end
end

function AudioController.start()
	for _, name in { "Song", "Ambience", "Heartbeat", "BlackoutDrone", "Dawn" } do
		makeSound(name, true)
	end
	for _, name in { "Pickup", "RarePickup", "SpeedBoost", "ShieldBreak", "Caught" } do
		makeSound(name, false)
	end

	NotifyController.shown:Connect(function(style)
		local name = STYLE_SOUND[style]
		if name then
			playOnce(name)
		end
	end)
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("Caught"):Connect(function()
		if player:GetAttribute("Caught") then
			playOnce("Caught")
		end
	end)

	ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
		onPhase(ReplicatedStorage:GetAttribute("Phase"))
	end)
	onPhase(ReplicatedStorage:GetAttribute("Phase") or "Lobby")
end

return AudioController
]]></ProtectedString>
						<string name="ScriptGuid">{EE63CF55-1055-4C42-91A7-B8A2186CB4AF}</string>
