			<Item class="ModuleScript" referent="RBXFB61F726D5A74FDE84993C76228B75C8">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Score: keeps each player's round points.
-- Points live in a "leaderstats" folder, which Roblox shows in the player list
-- (top right). Only the server changes them, so clients can't fake a score.

local Score = {}

local function getPoints(player: Player): IntValue?
	local leaderstats = player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild("Points")
end

function Score.setup(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local points = Instance.new("IntValue")
	points.Name = "Points"
	points.Parent = leaderstats

	leaderstats.Parent = player
end

function Score.add(player: Player, amount: number)
	local points = getPoints(player)
	if points then
		points.Value += amount
	end
end

function Score.reset(player: Player)
	local points = getPoints(player)
	if points then
		points.Value = 0
	end
end

return Score
]]></ProtectedString>
					<string name="ScriptGuid">{DD0C11A1-A22C-48F5-92C5-DC3058A803FF}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Score</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00001c38</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB42414E0623E4E7BBD4784C41F8FD110">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MushroomService: spawns mushrooms at the markers in Workspace.MushroomSpawns
-- and handles collecting them. Every check happens here on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local MushroomConfig = require(ReplicatedStorage.Shared.MushroomConfig)
local log = require(ReplicatedStorage.Shared.Log)
local Score = require(script.Parent.Score)

local STEM_SIZE = Vector3.new(0.7, 1.6, 0.7)
local CAP_SIZE = Vector3.new(2.6, 1.2, 2.6)

local MushroomService = {}

local activeFolder: Folder -- holds this round's mushrooms

local function newPart(name: string, size: Vector3, cframe: CFrame, color: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false -- players walk through it instead of tripping on it
	part.CastShadow = false
	part.Parent = parent
	return part
end

-- Builds a simple mushroom: a stem plus a squashed-sphere cap with a soft light.
local function buildMushroom(config, groundPosition: Vector3): Model
	local model = Instance.new("Model")
	model.Name = config.DisplayName

	local stemCFrame = CFrame.new(groundPosition + Vector3.new(0, STEM_SIZE.Y / 2, 0))
	local stem = newPart("Stem", STEM_SIZE, stemCFrame, config.StemColor, model)
	model.PrimaryPart = stem

	local capCFrame = CFrame.new(groundPosition + Vector3.new(0, STEM_SIZE.Y + CAP_SIZE.Y / 4, 0))
	local cap = newPart("Cap", CAP_SIZE, capCFrame, config.CapColor, model)
	local mesh = Instance.new("SpecialMesh") -- turns the block into a smooth dome shape
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = cap

	local light = Instance.new("PointLight")
	light.Color = config.GlowColor
	light.Brightness = 1
	light.Range = 8
	light.Parent = cap

	return model
end

-- True during the phases listed in GameConfig.CollectPhases (RoundService sets the phase).
local function isCollectPhase(): boolean
	return GameConfig.CollectPhases[ReplicatedStorage:GetAttribute("Phase")] == true
end

-- True if the player is alive and standing close enough to the mushroom.
local function canReach(player: Player, position: Vector3): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and humanoid.Health > 0) then
		return false
	end
	return (root.Position - position).Magnitude <= GameConfig.CollectDistance
end

local function onCollect(player: Player, model: Model, config)
	-- Already collected? (Destroyed models have no parent.) This stops double pickups.
	if not model.Parent then
		return
	end
	if not isCollectPhase() or not canReach(player, model.PrimaryPart.Position) then
		return
	end

	model:Destroy()
	Score.add(player, config.Points)
	log(player.Name, "collected", config.DisplayName, "+" .. config.Points)
end

local function spawnAt(marker: BasePart)
	local kind = marker:GetAttribute("MushroomType")
	local config = MushroomConfig[kind]
	if not config then
		warn("[TheLastLight] Unknown MushroomType on " .. marker:GetFullName() .. ": " .. tostring(kind))
		return
	end

	local groundPosition = marker.Position - Vector3.new(0, marker.Size.Y / 2, 0)
	local model = buildMushroom(config, groundPosition)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Collect"
	prompt.ObjectText = config.DisplayName
	prompt.MaxActivationDistance = GameConfig.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Enabled = isCollectPhase()
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		onCollect(player, model, config)
	end)

	model.Parent = activeFolder
end

-- Removes any leftover mushrooms and spawns a fresh one at every marker.
function MushroomService.spawnAll()
	if activeFolder then
		activeFolder:Destroy() -- also disconnects the old prompts' events
	end
	activeFolder = Instance.new("Folder")
	activeFolder.Name = "Mushrooms"
	activeFolder.Parent = workspace

	local spawns = workspace:FindFirstChild("MushroomSpawns")
	if not spawns then
		return -- Main already warns about the missing folder
	end
	for _, marker in spawns:GetChildren() do
		spawnAt(marker)
	end
	log("Mushrooms spawned:", #activeFolder:GetChildren())
end

-- Show the "Collect" prompts only while collecting is allowed. This is just for
-- clarity on screen; onCollect still checks the phase, so it stays secure.
ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
	if not activeFolder then
		return
	end
	local enabled = isCollectPhase()
	for _, item in activeFolder:GetDescendants() do
		if item:IsA("ProximityPrompt") then
			item.Enabled = enabled
		end
	end
end)

return MushroomService
]]></ProtectedString>
					<string name="ScriptGuid">{FA6BEB20-F77C-4ABD-B480-4161C872CDB9}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MushroomService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00001c3a</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE81AA0F448A84368B07876BA14A447FA">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- RoundService: owns the round timer. It is the ONLY script that changes the phase.
-- It publishes the round state as attributes on ReplicatedStorage, which every
-- client can read (including players who join mid-round):
--   Phase        current phase name, e.g. "Exploring"
--   Cycle        current night (1-4), or 0 during Lobby and Results
--   PhaseEndsAt  server time when the phase ends (compare with workspace:GetServerTimeNow())

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local log = require(ReplicatedStorage.Shared.Log)
local Score = require(script.Parent.Score)
local MushroomService = require(script.Parent.MushroomService)

local RoundService = {}

-- Announces a phase, then waits until it is over.
local function runPhase(phase: string, cycle: number)
	local duration = GameConfig.PhaseDurations[phase] * GameConfig.TimeScale
	ReplicatedStorage:SetAttribute("Cycle", cycle)
	ReplicatedStorage:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow() + duration)
	ReplicatedStorage:SetAttribute("Phase", phase) -- set last: scripts react to this one changing
	log(("Phase: %s (night %d, %.1fs)"):format(phase, cycle, duration))
	task.wait(duration)
end

-- Fresh mushrooms, scores back to 0, and everyone respawns at the trailhead.
local function resetRound()
	MushroomService.spawnAll()
	for _, player in Players:GetPlayers() do
		Score.reset(player)
		player:LoadCharacter()
	end
end

local function runRound()
	while #Players:GetPlayers() == 0 do
		Players.PlayerAdded:Wait()
	end

	resetRound()
	runPhase("Lobby", 0)
	for cycle = 1, GameConfig.CyclesPerRound do
		for _, phase in GameConfig.CyclePhases do
			runPhase(phase, cycle)
		end
	end
	runPhase("Results", 0)
end

-- Starts the endless round loop in the background.
function RoundService.start()
	task.spawn(function()
		while true do
			runRound()
		end
	end)
end

return RoundService
]]></ProtectedString>
					<string name="ScriptGuid">{D2D590F2-573A-470B-AAE1-E8EF9F699825}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RoundService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">5ca8ef1b1960c1ec0b0eb6ad00002138</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA7381A2367104001A70A71C3041F67D3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- SafeZoneService: decides, on the server, who is standing inside a safe light.
-- A player is safe when their HumanoidRootPart (the centre of the character) is inside
-- one of the circles in Workspace.SafeZones, during a phase in GameConfig.SafeZonePhases.
--
-- The result is published as a "Safe" attribute on each Player so the HUD can show it.
-- Other server scripts (the monster, later) call SafeZoneService.isPlayerSafe(player).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local log = require(ReplicatedStorage.Shared.Log)

local CHECK_INTERVAL = 0.2 -- seconds between checks
-- How far below or above a circle the character's centre may be and still count
-- (the centre is about 3 studs above the ground, and players can jump).
local HEIGHT_BELOW = 4
local HEIGHT_ABOVE = 12

local SafeZoneService = {}

local zones = {} -- list of { center: Vector3, radius: number }

-- Reads the circles once. The circles are cylinders lying flat, so their diameter is Size.Y.
local function loadZones()
	local folder = workspace:FindFirstChild("SafeZones")
	if not folder then
		return -- Main already warns about the missing folder
	end
	for _, disc in folder:GetChildren() do
		if disc:IsA("BasePart") then
			table.insert(zones, { center = disc.Position, radius = disc.Size.Y / 2 })
		end
	end
end

-- True if a world position is inside any safe circle (ignores the phase).
function SafeZoneService.isInsideZone(position: Vector3): boolean
	for _, zone in zones do
		local offset = position - zone.center
		local flatDistance = Vector2.new(offset.X, offset.Z).Magnitude
		if flatDistance <= zone.radius and offset.Y >= -HEIGHT_BELOW and offset.Y <= HEIGHT_ABOVE then
			return true
		end
	end
	return false
end

-- True if the player is protected right now: protection is active and they are inside a circle.
function SafeZoneService.isPlayerSafe(player: Player): boolean
	if not GameConfig.SafeZonePhases[ReplicatedStorage:GetAttribute("Phase")] then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and SafeZoneService.isInsideZone(root.Position)
end

local function updatePlayers()
	for _, player in Players:GetPlayers() do
		local safe = SafeZoneService.isPlayerSafe(player)
		if player:GetAttribute("Safe") ~= safe then
			player:SetAttribute("Safe", safe)
			log(player.Name, safe and "is safe" or "is not safe")
		end
	end
end

function SafeZoneService.start()
	loadZones()
	log("Safe zones loaded:", #zones)
	task.spawn(function()
		while true do
			updatePlayers()
			task.wait(CHECK_INTERVAL)
		end
	end)
end

return SafeZoneService
]]></ProtectedString>
